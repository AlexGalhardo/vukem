{
  "openapi": "3.1.0",
  "info": {
    "title": "Items",
    "version": "1.0.0"
  },
  "paths": {
    "/archive": {
      "post": {
        "operationId": "archive",
        "summary": "archive",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "why": {
                    "$ref": "#/components/schemas/archiving"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/items": {
      "get": {
        "operationId": "items.index",
        "summary": "items.index",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/itemList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/items/{id}": {
      "put": {
        "operationId": "items.update",
        "summary": "items.update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "item": {
                    "$ref": "#/components/schemas/itemInput"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/item"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "archiving": {
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "item": {
        "properties": {
          "color": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "labels": {
            "items": {
              "$ref": "#/components/schemas/label"
            },
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "seen": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "itemInput": {
        "properties": {
          "color": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "labels": {
            "items": {
              "$ref": "#/components/schemas/labelInput"
            },
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "seen": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "itemList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/item"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "label": {
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "labelInput": {
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "responses": {
      "Problem": {
        "description": "Error (RFC 9457 problem details)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed; errors maps each field to its messages",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
