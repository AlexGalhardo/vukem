{
  "openapi": "3.1.0",
  "info": {
    "title": "Shop",
    "version": "2.1.0"
  },
  "servers": [
    {
      "url": "https://shop.example"
    }
  ],
  "paths": {
    "/api/v1/legacy/{path}": {
      "get": {
        "operationId": "legacy",
        "summary": "legacy",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "4XX": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "description": "Response",
            "content": {
              "*/*": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "operationId": "products.index",
        "summary": "List products",
        "tags": [
          "products"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "maxLength": 50,
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/page"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/products/{id}": {
      "delete": {
        "operationId": "products.destroy",
        "summary": "products.destroy",
        "deprecated": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/shops/{shop}/products": {
      "post": {
        "operationId": "products.store",
        "summary": "Create a product",
        "tags": [
          "products"
        ],
        "parameters": [
          {
            "name": "shop",
            "in": "path",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "code": {
                    "pattern": "^[A-Z]{2,4}$",
                    "type": "string"
                  },
                  "email": {
                    "format": "email",
                    "type": "string"
                  },
                  "name": {
                    "description": "Display name",
                    "maxLength": 80,
                    "minLength": 2,
                    "type": "string"
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "price": {
                    "format": "double",
                    "maximum": 9999.99,
                    "minimum": 0,
                    "type": "number"
                  },
                  "status": {
                    "enum": [
                      "draft",
                      "published"
                    ],
                    "type": "string"
                  },
                  "tags": {
                    "items": {
                      "maxLength": 20,
                      "minLength": 1,
                      "type": "string"
                    },
                    "maxItems": 5,
                    "type": "array",
                    "uniqueItems": true
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/product"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/webhooks/{provider}": {
      "post": {
        "operationId": "webhooks.receive",
        "summary": "webhooks.receive",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        },
        "responses": {
          "4XX": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "description": "Response",
            "content": {
              "*/*": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "author": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "page": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/product"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "product": {
        "properties": {
          "Author": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/author"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "deleted_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "meta": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "format": "double",
            "type": "number"
          },
          "published_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "related": {
            "items": {
              "$ref": "#/components/schemas/product"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "responses": {
      "Problem": {
        "description": "Error (RFC 9457 problem details)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed; errors maps each field to its messages",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  }
}
