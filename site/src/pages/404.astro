---
import Base from "../layouts/Base.astro";
import { NotFoundView } from "@/components/not-found-view";
---

<Base title="Page not found" description="The page you are looking for does not exist or has moved.">
  <NotFoundView />
  <script is:inline>
    (function () {
      var path = location.pathname;
      if (path !== "/pt-br" && path.indexOf("/pt-br/") !== 0) return;
      // Rebuilt as a same-origin URL: "/pt-br//host" must not become "//host".
      var rest = path.slice("/pt-br".length).replace(/^[\/\\]+/, "");
      var url = new URL("/" + rest, location.origin);
      if (url.origin !== location.origin) return;
      location.replace(url.pathname + location.search + location.hash);
    })();
  </script>
</Base>
