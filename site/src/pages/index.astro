---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';

const keywords = new Set([
  "func", "return", "var", "if", "type", "struct", "map", "nil", "true", "false",
  "package", "import", "range", "for", "else", "chan", "go", "defer",
]);
const predeclared = new Set(["string", "int", "int64", "bool", "error", "byte", "any"]);

function escapeHtml(value) {
  return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

function highlightLine(line) {
  const commentAt = line.indexOf("//");
  const source = commentAt >= 0 ? line.slice(0, commentAt) : line;
  const comment = commentAt >= 0 ? line.slice(commentAt) : "";
  const pattern = /(`[^`]*`|"(?:\\.|[^"\\])*")|(\d+)|([A-Za-z_][A-Za-z0-9_]*)|(\s+)|([\s\S])/g;
  let html = "";
  let match;
  while ((match = pattern.exec(source))) {
    const [token, str, num, ident] = match;
    if (str) html += `<span class="str">${escapeHtml(str)}</span>`;
    else if (num) html += `<span class="num">${num}</span>`;
    else if (ident) {
      const call = /^\s*\(/.test(source.slice(pattern.lastIndex));
      const cls = keywords.has(ident)
        ? "kw"
        : predeclared.has(ident)
          ? "typ"
          : call
            ? "fn"
            : /^[A-Z]/.test(ident)
              ? "typ"
              : "";
      html += cls ? `<span class="${cls}">${escapeHtml(ident)}</span>` : escapeHtml(ident);
    } else html += escapeHtml(token);
  }
  if (comment) html += `<span class="cmt">${escapeHtml(comment)}</span>`;
  return html;
}

function highlight(code) {
  return code
    .split("\n")
    .map((line, index) => {
      const n = String(index + 1).padStart(2, " ");
      return `<span class="ln" aria-hidden="true">${n}</span>${highlightLine(line)}`;
    })
    .join("\n");
}

const features = [
  {
    id: "routing",
    label: "Routing",
    note: "Named routes and resource routes live in one file, with the middleware and the handler each endpoint calls.",
    code: [
      "guest := auth.Guest(acc.Web)",
      "",
      'r.Get("/login", h.ShowLogin).',
      '\tName("login").Use(guest)',
      'r.Post("/login", h.Login).Use(guest)',
      'r.Get("/register", h.ShowRegister).',
      '\tName("register").Use(guest)',
      'r.Post("/register", h.Register).Use(guest)',
      "",
      "// Seven REST actions for posts.",
      'r.Resource("posts", controllers.',
      "\tNewPostController(db))",
    ].join("\n"),
  },
  {
    id: "controllers",
    label: "Controllers",
    note: "A controller method is func(c *web.Ctx) error. The router calls that method value directly.",
    code: [
      "func (pc *PostController) Show(",
      "\tc *web.Ctx,",
      ") error {",
      "\tpost, err := pc.find(c)",
      "\tif err != nil {",
      "\t\treturn err",
      "\t}",
      "",
      '\treturn c.Render("posts/show", post)',
      "}",
      "",
      "func (pc *PostController) find(",
      "\tc *web.Ctx,",
      ") (models.Post, error) {",
      '\tid, err := c.ParamInt("post")',
      "\tif err != nil {",
      "\t\treturn models.Post{}, err",
      "\t}",
      "",
      "\treturn orm.QueryOf[models.Post](pc.db).",
      "\t\tFind(c.Context(), id)",
      "}",
    ].join("\n"),
  },
  {
    id: "validators",
    label: "Validators",
    note: "z.Struct describes the form once. web.Parse answers 422, or redirects back, when a field is invalid.",
    code: [
      "type StoreComment struct {",
      '\tAuthor string `json:"author" form:"author"`',
      '\tBody   string `json:"body" form:"body"`',
      "}",
      "",
      "var StoreCommentSchema = z.Struct[",
      "\tStoreComment,",
      "](z.Shape{",
      '\t"author": z.String().Trim().Min(2).Max(60),',
      '\t"body": z.String().Trim().Min(3).Max(500),',
      "})",
    ].join("\n"),
  },
  {
    id: "models",
    label: "Models",
    note: "The struct is the table row. QueryOf chains OrderBy and Limit, then Get runs the query.",
    code: [
      "type Post struct {",
      "\torm.Model",
      "",
      '\tUserID int64  `json:"user_id"`',
      '\tTitle  string `json:"title"`',
      '\tBody   string `json:"body"`',
      "}",
      "",
      "posts, err := orm.QueryOf[models.Post](db).",
      '\tOrderBy("id", orm.Desc).',
      "\tLimit(20).",
      "\tGet(c.Context())",
    ].join("\n"),
  },
  {
    id: "auth",
    label: "Auth",
    note: "The session guard hashes passwords with argon2id. Attempt checks the credentials and signs the user in.",
    code: [
      "web := auth.NewSessionGuard(",
      '\t"web",',
      "\tauth.NewORMProvider[models.User](db),",
      "\thash.Default(), // argon2id",
      "\tauth.NewRememberStore(db),",
      ")",
      "",
      "_, err = h.a.Web.Attempt(",
      "\tc, creds, auth.Remember(in.Remember),",
      ")",
    ].join("\n"),
  },
  {
    id: "uploads",
    label: "File uploads",
    note: "upload.Receive streams each file through the size, type and count rules, then stores it on a disk.",
    code: [
      "func photoRules() upload.Rules {",
      "\trules := upload.Images(5 << 20)",
      "\trules.MaxFiles = 5",
      '\trules.Dir = "photos"',
      "",
      "\treturn rules",
      "}",
      "",
      "form, err := upload.Receive(",
      "\tc, pc.disk, photoRules(),",
      ")",
    ].join("\n"),
  },
  {
    id: "emails",
    label: "Emails",
    note: "A mailable is an envelope plus a view. Mailer().Send delivers it, or logs it outside production.",
    code: [
      "func (m OrderShipped) Envelope() (",
      "\tmail.Envelope,",
      ") {",
      "\treturn mail.Envelope{",
      "\t\tTo: []string{m.Order.CustomerEmail},",
      '\t\tSubject: "Your order has shipped",',
      "\t}",
      "}",
      "",
      "err = mailer.Send(c.Context(),",
      "\tshopmail.OrderShipped{",
      "\t\tOrder: order,",
      "\t\tTrackingURL:",
      '\t\t\t"https://example.com/track/" +',
      "\t\t\t\torder.Number,",
      "\t})",
    ].join("\n"),
  },
  {
    id: "limiter",
    label: "Rate limiter",
    note: "Five login attempts per minute, keyed by client IP. The next attempt is rejected.",
    code: [
      "limiters, err := app.RateLimiters()",
      "if err != nil {",
      "\treturn err",
      "}",
      "",
      "// 5 login attempts per minute, by IP.",
      "throttle := ratelimit.Middleware(",
      '\tlimiters("login", 5, time.Minute),',
      "\tratelimit.ByIP,",
      ")",
      "",
      'r.Post("/login", login).',
      '\tName("login.store").Use(throttle)',
    ].join("\n"),
  },
  {
    id: "testing",
    label: "Testing",
    note: "vukemtest boots the real app in memory and asserts the response. No port is opened.",
    code: [
      "func TestPostsIndex(t *testing.T) {",
      "\tapp := vukemtest.New(t, bootstrap.New)",
      "",
      '\tapp.Client(t).Get("/posts").AssertOK()',
      "}",
    ].join("\n"),
  },
];
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Vukem — From idea to application</title><meta name="description" content="Build APIs and full-stack applications with Vukem, a Go web framework. Routing, auth, models and the rest of the framework in real code." /><link rel="canonical" href="https://vukem.dev/" /><link rel="icon" href="/icon.svg" /><meta name="theme-color" content="#07090d" /><meta property="og:title" content="Vukem — From idea to application" /><meta property="og:description" content="Your next product starts here. A Go framework for APIs and full-stack apps." /><meta property="og:image" content="https://vukem.dev/icon.svg" /></head>
<body>
<div id="scene" aria-hidden="true"></div>
<main>
<header><span class="wordmark">vukem<span class="dot">.</span></span><span class="edition">GO FRAMEWORK <span class="status"></span> OPEN SOURCE</span></header>
<section class="hero" aria-labelledby="headline">
<div class="intro"><p class="eyebrow"><span>01 / BUILD SOMETHING REAL</span></p><h1 id="headline">From idea.<br />To <em>application.</em></h1><p class="description">A Go framework for the things you want to build.<br class="desktop" /> APIs. Full-stack apps. Your next product.</p><a class="cta" href="/docs/introduction/">Read Docs <span aria-hidden="true">↗</span></a><p class="command"><span aria-hidden="true">$</span> vukem new money --example finance<span class="cursor" aria-hidden="true">_</span></p></div>
<section class="showcase" aria-label="Framework features">
<div class="tabs" role="tablist" aria-label="Features">
{features.map((feature, index) => (
<button type="button" role="tab" id={`tab-${feature.id}`} aria-selected={index === 0 ? "true" : "false"} aria-controls={`panel-${feature.id}`} tabindex={index === 0 ? 0 : -1} data-note={feature.note}>{feature.label}</button>
))}
</div>
<div class="stage">
{features.map((feature, index) => (
<div role="tabpanel" id={`panel-${feature.id}`} aria-labelledby={`tab-${feature.id}`} hidden={index !== 0 || undefined}><pre><code set:html={highlight(feature.code)} /></pre></div>
))}
</div>
<p class="note" id="feature-note"><span class="status" aria-hidden="true"></span> {features[0].note}</p>
</section>
</section>
<footer><span>LESS FRICTION. MORE BUILDING.</span><span>BUILT ON net/http <span class="slash">/</span> MADE FOR YOUR NEXT IDEA</span></footer>
</main>
<script>import '../scripts/landing.js';</script>
<style is:global>
*{box-sizing:border-box}html,body{margin:0;background:#07090d;color:#edf1f5;font-family:Inter,sans-serif}body{height:100dvh;overflow:hidden}#scene{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 75% 30%,#112b333d,transparent 65%)}#scene canvas{display:block;width:100%;height:100%}main{position:relative;min-height:0;height:100dvh;padding:32px 5vw 24px;display:flex;flex-direction:column}header,footer{display:flex;justify-content:space-between;align-items:center;flex-shrink:0}.wordmark{font-size:35px;font-weight:600;letter-spacing:-2px}.dot{color:#38e1ff}.edition,.eyebrow,footer,.command{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1.4px;color:#8494a7}.edition{display:flex;align-items:center;gap:14px}.status{display:inline-block;width:5px;height:5px;border-radius:50%;background:#38e1ff;box-shadow:0 0 10px #38e1ff70}.hero{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.28fr);align-items:center;gap:3vw}.eyebrow{color:#38e1ff;margin:0 0 30px}h1{font-size:clamp(42px,4.6vw,92px);line-height:1.08;font-weight:600;letter-spacing:-.065em;margin:0}h1 em{font-style:normal;color:#38e1ff}.description{color:#9caabb;font-size:clamp(13px,1.2vw,18px);line-height:1.8;margin:25px 0 30px}.cta{display:inline-flex;align-items:center;gap:45px;background:#edf1f5;color:#07090d;border:1px solid #edf1f5;border-radius:4px;padding:15px 22px;font-weight:600;font-size:13px;text-decoration:none;transition:background .2s,transform .2s}.cta:hover{background:#38e1ff;transform:translateY(-2px)}.cta:focus-visible,.tabs button:focus-visible{outline:3px solid #38e1ff;outline-offset:4px}.command{margin:28px 0 0;font-size:10px;letter-spacing:0}.command>span:first-child{color:#38e1ff;margin-right:9px}.cursor{animation:blink 1.2s steps(1) infinite}
.showcase{min-width:0;min-height:0;max-height:100%;display:flex;flex-direction:column;background:#10141c;border:1px solid #2c3544;border-radius:10px;overflow:hidden;box-shadow:0 24px 80px #0009}.tabs{display:flex;flex-shrink:0;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid #2c3544}.tabs::-webkit-scrollbar{display:none}.tabs button{flex:1 0 auto;appearance:none;background:transparent;color:#d5dbe3;border:0;border-right:1px solid #2c3544;padding:11px 8px;font:600 12px/1 Inter,sans-serif;cursor:pointer;white-space:nowrap;text-align:center}.tabs button[aria-selected="true"]{background:#5b4dff;color:#fff}.stage{flex:1;min-height:0;overflow:auto;background:#0c0f16}.stage pre{margin:0;padding:16px 18px 20px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12.5px;line-height:1.55;color:#d7dee8;tab-size:4}.stage code{font:inherit}.ln{display:inline-block;width:2.4ch;margin-right:1.6ch;color:#526070;user-select:none;text-align:right}.kw{color:#c792ea}.str{color:#c3e88d}.cmt{color:#6d7887}.fn{color:#82aaff}.typ{color:#ffcb6b}.num{color:#f78c6c}.note{flex-shrink:0;display:flex;gap:10px;align-items:flex-start;margin:0;padding:12px 16px;border-top:1px solid #2c3544;color:#c5ced6;font-size:13px;line-height:1.45}.note .status{margin-top:6px}
footer{border-top:1px solid #23303a;padding-top:18px;font-size:8px;letter-spacing:1px}.slash{color:#38e1ff;margin:0 15px}@keyframes blink{50%{opacity:0}}
@media(max-width:760px){main{padding:max(16px,env(safe-area-inset-top)) 5vw max(12px,env(safe-area-inset-bottom))}.wordmark{font-size:26px}.edition{font-size:7px;gap:8px;letter-spacing:.4px}.hero{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);gap:14px;align-content:stretch}.eyebrow{font-size:8px;margin-bottom:10px}h1{font-size:clamp(34px,9vw,52px)}.description{font-size:12px;margin:10px 0 14px;line-height:1.5}.cta{padding:11px 16px;font-size:12px;gap:28px}.command{font-size:8px;margin-top:12px}.tabs button{padding:9px 11px;font-size:12px}.stage pre{font-size:10px;padding:12px 12px 16px}.note{font-size:12px;padding:10px 12px}footer{font-size:6px;padding-top:10px;letter-spacing:.4px}footer>span:last-child{display:none}.desktop{display:none}}
@media(max-height:700px) and (min-width:761px){main{padding-top:16px;padding-bottom:12px}h1{font-size:clamp(36px,4vw,64px)}.eyebrow{margin-bottom:14px}.description{margin:12px 0 16px}.command{margin-top:14px}.stage pre{font-size:11.5px}.note{font-size:12px;padding:10px 14px}}
@media(max-height:700px) and (max-width:760px){main{padding-top:12px;padding-bottom:8px}.hero{gap:10px}.description{margin:8px 0 10px}.eyebrow{margin-bottom:8px}.command{display:none}h1{font-size:32px}.tabs button{padding:8px 10px}.stage pre{font-size:10px;line-height:1.45}.note{font-size:11px;padding:8px 10px}footer{padding-top:8px}}
@media(orientation:landscape) and (max-height:500px){main{padding:10px 4vw}.wordmark{font-size:22px}.hero{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);grid-template-rows:minmax(0,1fr);gap:3vw}.eyebrow{font-size:7px;margin-bottom:8px}h1{font-size:30px}.description{font-size:11px;margin:8px 0;line-height:1.4}.command{display:none}.cta{padding:8px 12px}.tabs button{padding:7px 9px;font-size:11px}.stage pre{font-size:10px;padding:8px 10px}.note{font-size:11px;padding:6px 10px}footer{padding-top:6px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
</style>
</body></html>
