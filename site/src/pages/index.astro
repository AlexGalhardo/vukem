---
import Base from "../layouts/Base.astro";

const features = [
  { number: "01", title: "Go all the way", description: "Build on net/http with familiar Go handlers, middleware, and packages. Keep the control you expect from Go." },
  { number: "02", title: "Start with a real app", description: "Generate a working starter with routes, migrations, views, tests, and the pieces you need to ship." },
  { number: "03", title: "Pick your stack", description: "Use HTMX, templ, Inertia with React, Vue or Svelte, or create a JSON API. One framework, your choice." },
];
---

<Base title="Vukem — Web apps, the Go way" description="Build web apps and APIs in Go with a working starter, familiar net/http foundations, and your choice of frontend." canonical="/">
  <main id="content" class="home overflow-hidden">
    <section class="relative mx-auto grid max-w-[90rem] gap-8 px-5 pb-16 pt-16 sm:px-8 sm:pt-20 lg:min-h-[min(43rem,calc(100dvh-3.5rem))] lg:grid-cols-[minmax(0,1.25fr)_minmax(18rem,.75fr)] lg:items-center lg:gap-4 lg:px-16 lg:pb-20 lg:pt-12">
      <div class="relative z-10 max-w-[48rem]">
        <a href="/docs/introduction" class="mb-8 inline-flex items-center gap-2 rounded-full border border-border-strong bg-bg px-3 py-1.5 text-xs font-semibold tracking-wide text-muted transition hover:border-brand hover:text-fg">
          <span class="size-1.5 rounded-full bg-brand"></span>
          The Go framework for getting things done
          <span aria-hidden="true" class="text-brand">↗</span>
        </a>
        <h1 class="max-w-[12ch] text-[clamp(3.25rem,7.5vw,6.7rem)] font-semibold leading-[.97] tracking-[-.075em] text-fg">
          Make more.<br /><span class="text-brand">Wire less.</span>
        </h1>
        <p class="mt-7 max-w-[35rem] text-[1.05rem] leading-[1.7] text-muted sm:text-[1.16rem]">
          Build full-stack web apps and APIs in Go. Start with a working project, choose the frontend you like, and get back to building.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="/docs/quick-start" class="inline-flex min-h-11 items-center gap-3 rounded-lg bg-fg px-5 py-2.5 text-sm font-semibold text-bg transition hover:opacity-80">Get started <span aria-hidden="true">↗</span></a>
          <a href="/docs/introduction" class="inline-flex min-h-11 items-center gap-3 rounded-lg border border-border-strong bg-bg px-5 py-2.5 text-sm font-semibold text-fg transition hover:bg-hover">Explore the docs <span aria-hidden="true">→</span></a>
        </div>
        <div class="mt-12 max-w-[38rem] overflow-hidden rounded-xl border border-border-strong bg-code-bg shadow-[0_20px_60px_-30px_rgba(0,0,0,.2)]">
          <div class="flex h-9 items-center gap-1.5 border-b border-border px-4"><span class="size-2 rounded-full bg-[#ff6b6b]"></span><span class="size-2 rounded-full bg-[#f3c35a]"></span><span class="size-2 rounded-full bg-[#64c584]"></span><span class="ml-auto font-mono text-[.625rem] text-faint">terminal</span></div>
          <div class="flex items-center justify-between gap-3 px-4 py-4 sm:px-5"><code class="min-w-0 overflow-x-auto whitespace-nowrap font-mono text-[.75rem] text-fg sm:text-[.82rem]"><span class="mr-3 text-brand">$</span>vukem new myapp --example todo</code><button type="button" data-copy="vukem new myapp --example todo" aria-label="Copy starter command" class="shrink-0 rounded-md border border-border px-2.5 py-1.5 text-[.65rem] font-medium text-muted transition hover:border-border-strong hover:text-fg">Copy</button></div>
        </div>
      </div>
      <div class="relative flex min-h-[24rem] items-center justify-center lg:min-h-[33rem]" aria-label="Go gopher mascot">
        <div class="absolute size-[min(80vw,31rem)] rounded-full border border-brand/15 bg-[radial-gradient(circle,var(--accent-soft)_0%,transparent_70%)]"></div>
        <div class="absolute size-[min(68vw,26rem)] rounded-full border border-brand/20"></div>
        <div class="absolute size-[min(50vw,19rem)] rounded-full border border-brand/15"></div>
        <span class="absolute right-[6%] top-[18%] rounded-lg border border-border-strong bg-bg px-3 py-2 font-mono text-[.75rem] text-brand shadow-sm rotate-6">net/http</span>
        <span class="absolute bottom-[19%] left-[4%] rounded-lg border border-border-strong bg-bg px-3 py-2 font-mono text-[.75rem] text-brand shadow-sm -rotate-6">go run .</span>
        <img src="/gopher.svg" alt="Friendly blue Go gopher waving" class="relative z-10 w-[min(67vw,24rem)] drop-shadow-[0_25px_35px_rgba(0,100,140,.18)]" width="440" height="450" />
      </div>
    </section>

    <div class="border-y border-border bg-subtle"><div class="mx-auto flex max-w-[90rem] flex-wrap items-center justify-between gap-4 px-5 py-5 text-[.7rem] font-medium uppercase tracking-[.18em] text-faint sm:px-8 lg:px-16"><span>Built on Go</span><span>Web apps</span><span>JSON APIs</span><span>Real starters</span><span>Your frontend</span></div></div>

    <section class="mx-auto max-w-[90rem] px-5 py-20 sm:px-8 lg:px-16 lg:py-28">
      <div class="mb-11 max-w-[42rem]"><p class="mb-4 text-xs font-semibold uppercase tracking-[.2em] text-brand">From idea to running app</p><h2 class="text-[clamp(2.4rem,4.5vw,4rem)] font-semibold leading-[1.05] tracking-[-.06em]">Everything in place.<br />Room to make it yours.</h2><p class="mt-5 text-[.98rem] leading-7 text-muted">Vukem gives you a useful starting point and stays close to the Go you already know.</p></div>
      <div class="grid gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-3">
        {features.map((feature) => <article class="bg-bg p-7 sm:p-9"><span class="font-mono text-xs text-brand">/{feature.number}</span><h3 class="mt-9 text-xl font-semibold tracking-[-.035em]">{feature.title}</h3><p class="mt-3 text-sm leading-7 text-muted">{feature.description}</p></article>)}
      </div>
      <div class="mt-12 flex flex-wrap items-center justify-between gap-5 rounded-xl border border-border bg-subtle px-7 py-8 sm:px-9"><div><h2 class="text-xl font-semibold tracking-[-.035em]">Ready to make something?</h2><p class="mt-1 text-sm text-muted">The quick start takes you from installation to a running app. <a href="https://github.com/AlexGalhardo/vukem/issues/new/choose" class="underline decoration-border-strong underline-offset-2 hover:text-fg">Report a bug</a> or read the <a href="https://github.com/AlexGalhardo/vukem/blob/main/.github/CONTRIBUTING.md" class="underline decoration-border-strong underline-offset-2 hover:text-fg">contribution guide</a> before you send a change.</p></div><a href="/docs/quick-start" class="inline-flex items-center gap-2 rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white transition hover:opacity-85">Read the quick start <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <footer class="border-t border-border"><div class="mx-auto flex max-w-[90rem] flex-wrap items-center justify-between gap-3 px-5 py-8 text-xs text-faint sm:px-8 lg:px-16"><span>© {new Date().getFullYear()} Vukem</span><div class="flex gap-5"><a href="/docs/quick-start" class="hover:text-fg">Install</a><a href="https://github.com/AlexGalhardo/vukem/issues/new/choose" class="hover:text-fg">Report a bug</a><a href="https://github.com/AlexGalhardo/vukem/blob/main/.github/CONTRIBUTING.md" class="hover:text-fg">Contribute</a><a href="/docs/introduction" class="hover:text-fg">Documentation</a><a href="/changelog" class="hover:text-fg">Changelog</a><a href="https://github.com/AlexGalhardo/vukem" target="_blank" rel="noreferrer" class="hover:text-fg">GitHub</a></div></div></footer>
</Base>
