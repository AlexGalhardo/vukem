---
import Base from "../layouts/Base.astro";
import { CopyButton } from "@/components/copy-button";
import { highlight } from "@/lib/highlight";
import { commands, copyText, highlights, richText, tabs } from "@/lib/landing";

// Every sample is trimmed from the docs page or example named in `source`; keep them in sync.
const panels = await Promise.all(
	tabs.map(async (tab) => ({
		tab,
		copy: copyText(tab.files),
		files: await Promise.all(tab.files.map(async (file) => ({ ...file, html: await highlight(file.code, file.lang) }))),
		kind: tab.files.every((f) => f.lang === "bash") ? "Terminal" : tab.files.some((f) => f.lang === "html") ? "HTML, Go" : "Go",
	})),
);
---

<Base title="Vukem — Web apps, the Go way" description="Build web apps and APIs in Go with a working starter, familiar net/http foundations, and your choice of frontend." canonical="/">
	<main id="content" class="home flex flex-col gap-5 px-5 pb-6 pt-6 md:h-[calc(100dvh-var(--header-h))] md:gap-3 md:overflow-hidden md:px-8 md:pb-3 md:pt-6 lg:px-16 [@media(max-height:360px)]:h-auto [@media(max-height:360px)]:overflow-visible">
		<div class="mx-auto grid w-full max-w-[90rem] min-h-0 flex-1 grid-cols-1 gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-center md:gap-8 lg:gap-12">
			<section class="min-w-0" aria-label="Get started">
				<h1 class="text-[clamp(2rem,min(3.8vw,6.5vh),3.5rem)] font-semibold leading-[1.02] tracking-[-.06em] text-fg">
					Make more. <span class="text-brand">Wire less.</span>
				</h1>
				<p class="mt-2 max-w-[38rem] text-[.9rem] leading-[1.5] text-muted" set:html={richText("Vukem is a [[full-stack|It covers the whole app: routing, validation, a database layer, auth, views, jobs and tests. APIs are first-class too.]] web framework for Go, for developers who want Laravel-style productivity with idiomatic, standard-library code. Start from a working project and pick your frontend.")} />
				<div role="group" aria-label="Install commands" class="terminal mt-3 max-w-[40rem] overflow-hidden rounded-xl border border-[#3a3d44] bg-[#1c1e24] font-mono text-[.72rem] text-[#e6e8ee] shadow-lg">
					<div class="flex h-8 items-center gap-2 border-b border-[#3a3d44] bg-[#2a2c33] px-3" aria-hidden="true">
						<span class="size-3 rounded-full bg-[#ff5f57]"></span><span class="size-3 rounded-full bg-[#febc2e]"></span><span class="size-3 rounded-full bg-[#28c840]"></span>
						<span class="ml-2 text-[.68rem] text-[#9a9ea8]">Terminal</span>
					</div>
					<ul class="py-1">
						{commands.map((cmd) => (
							<li class="flex items-center justify-between gap-2 py-0.5 pl-3 pr-1">
								<code class="min-w-0 whitespace-pre-wrap break-all py-1 pl-[2ch] -indent-[2ch]"><span class="select-none text-[#28c840]" aria-hidden="true">$ </span>{cmd}</code>
								<CopyButton client:visible text={cmd} className="terminal-copy" />
							</li>
						))}
					</ul>
				</div>
				<ul class="mt-3 grid max-w-[40rem] gap-1 [@media(min-width:768px)_and_(max-width:1199px)_and_(max-height:860px)]:hidden text-[.82rem] leading-[1.45] text-muted">
					{highlights.map((item) => (
						<li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span><span><strong class="font-semibold text-fg">{item.label}</strong>{" "}<Fragment set:html={richText(item.text)} /></span></li>
					))}
				</ul>
				<div class="mt-3 flex flex-wrap items-center gap-2">
					<a href="/docs/quick-start" class="inline-flex min-h-9 items-center gap-2 rounded-lg bg-fg px-4 py-1.5 text-sm font-semibold text-bg transition hover:opacity-80">Read the quick start <span aria-hidden="true">→</span></a>
				</div>
			</section>

			<section data-feature-tabs class="flex min-h-0 min-w-0 flex-col gap-2 md:max-h-full" aria-label="Framework features">
				<div role="tablist" aria-label="Framework features" class="tablist -mx-5 flex shrink-0 snap-x snap-proximity gap-2 overflow-x-auto px-6 py-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0 md:px-1 md:pr-10">
					{panels.map(({ tab }, i) => (
						<button type="button" role="tab" id={`tab-${tab.id}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`panel-${tab.id}`} tabindex={i === 0 ? 0 : -1} class="shrink-0 snap-start rounded-full border border-border-strong px-4 py-1.5 text-sm font-medium text-muted transition-colors hover:text-fg aria-selected:border-fg aria-selected:bg-fg aria-selected:text-bg">{tab.label}</button>
					))}
				</div>
				<div class="tab-panels grid min-h-0 grid-cols-[minmax(0,1fr)]">
					{panels.map(({ tab, files, copy, kind }, i) => (
						<div role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} inert={i !== 0} data-active={i === 0 ? "" : undefined} data-source={tab.source} class="col-start-1 row-start-1 flex min-h-0 flex-col gap-3">
							<figure class="landing-code flex h-[var(--code-h)] shrink-0 flex-col overflow-hidden rounded-xl border border-border bg-code-bg">
								<figcaption class="flex h-10 shrink-0 items-center justify-between border-b border-border pr-1.5 pl-4"><span class="truncate font-mono text-xs text-muted">{kind}</span><CopyButton client:visible text={copy} /></figcaption>
								<div class="code-body min-h-0 flex-1 overflow-y-auto" role="region" aria-label={`${tab.label} code`} tabindex="0">
									{files.map((file) => (
										<div class="code-file">
											<div class="code-file-name" aria-hidden="true">{file.path}</div>
											<Fragment set:html={file.html} />
										</div>
									))}
								</div>
							</figure>
							<div class="shrink-0">
								<h2 class="text-[1.05rem] font-semibold leading-snug tracking-[-.03em]">{tab.title}</h2>
								<p class="mt-1 text-[.8rem] leading-[1.45] text-muted" set:html={richText(tab.text)} />
								<ul class="mt-2 space-y-0.5 text-[.8rem] leading-[1.45] text-fg">
									{tab.points.map((point) => <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span><span set:html={richText(point)} /></li>)}
								</ul>
							</div>
						</div>
					))}
				</div>
			</section>
		</div>

		<footer class="mx-auto flex w-full max-w-[90rem] shrink-0 flex-wrap items-center justify-between gap-x-5 gap-y-1 text-[.7rem] text-faint">
			<span>© {new Date().getFullYear()} Vukem. Go Gopher by Renee French, <a href="https://creativecommons.org/licenses/by/4.0/" class="underline underline-offset-2 hover:text-fg">CC BY 4.0</a>.</span>
			<nav class="flex gap-4" aria-label="Footer"><a href="/docs/introduction" class="hover:text-fg">Documentation</a><a href="/changelog" class="hover:text-fg">Changelog</a><a href="https://github.com/AlexGalhardo/vukem/issues/new/choose" class="hover:text-fg">Report a bug</a><a href="https://github.com/AlexGalhardo/vukem/blob/main/.github/CONTRIBUTING.md" class="hover:text-fg">Contribute</a><a href="https://github.com/AlexGalhardo/vukem" target="_blank" rel="noreferrer" class="hover:text-fg">GitHub</a></nav>
		</footer>

		<div id="tip-pop" aria-hidden="true" hidden></div>
	</main>

</Base>

<style is:global>
	/* The code block has a fixed height; its own scroller takes the overflow, so the page never scrolls from 768px. */
	.home {
		--code-h: 24rem;
	}

	@media (min-width: 768px) {
		.home {
			--code-h: clamp(15rem, calc(100dvh - 460px), 32rem);
		}
	}

	.landing-code .shiki {
		padding: 0.5rem 1rem 0.75rem;
		font-size: 0.75rem;
		line-height: 1.55;
		tab-size: 2;
	}

	.landing-code .code-file + .code-file {
		border-top: 1px solid var(--border);
	}

	.landing-code .code-file-name {
		padding: 0.5rem 1rem 0;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--faint);
	}

	.code-body {
		scrollbar-width: thin;
		scrollbar-color: var(--border-strong) transparent;
	}

	.code-body::-webkit-scrollbar {
		width: 0.5rem;
	}

	.code-body::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: var(--border-strong);
	}

	/* Inset ring: the figure clips anything drawn outside it. */
	.code-body:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	.tab-panels > [role="tabpanel"]:not([data-active]) {
		visibility: hidden;
	}

	.tablist {
		mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
	}

	.terminal .terminal-copy {
		color: #9a9ea8;
	}

	.terminal .terminal-copy:hover {
		background: rgb(255 255 255 / 0.1);
		color: #fff;
	}

	.terminal :focus-visible {
		outline-offset: -2px;
		border-radius: 0.375rem;
	}

	.tab-panels {
		view-transition-name: landing-panels;
	}

	.tip {
		cursor: help;
		border-radius: 0.125rem;
		text-decoration: underline dotted;
		text-decoration-color: var(--faint);
		text-underline-offset: 0.2em;
	}

	.tip:hover,
	.tip:focus-visible {
		text-decoration-color: var(--accent);
	}

	#tip-pop {
		position: fixed;
		z-index: 60;
		max-width: min(18rem, calc(100vw - 1rem));
		border: 1px solid var(--border-strong);
		border-radius: 0.375rem;
		background: var(--bg);
		padding: 0.375rem 0.625rem;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--fg);
		box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
	}

	#tip-pop[hidden] {
		display: none;
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>("[data-feature-tabs]");
	const pop = document.getElementById("tip-pop");
	let hideTip = () => {};

	if (root) {
		const tabs = [...root.querySelectorAll<HTMLElement>("[role=tab]")];
		const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
		const reduced = matchMedia("(prefers-reduced-motion: reduce)");

		const select = (tab: HTMLElement) => {
			const apply = () => {
				tabs.forEach((t, i) => {
					const on = t === tab;
					t.setAttribute("aria-selected", String(on));
					t.tabIndex = on ? 0 : -1;
					panels[i].inert = !on;
					panels[i].toggleAttribute("data-active", on);
				});
			};
			hideTip();
			if (typeof document.startViewTransition === "function" && !reduced.matches) document.startViewTransition(apply);
			else apply();
			tab.focus();
			tab.scrollIntoView({ block: "nearest", inline: "nearest" });
		};

		tabs.forEach((tab) => tab.addEventListener("click", () => select(tab)));
		root.querySelector("[role=tablist]")?.addEventListener("keydown", (event) => {
			const key = (event as KeyboardEvent).key;
			const i = tabs.indexOf(document.activeElement as HTMLElement);
			if (i < 0) return;
			const next = { ArrowRight: (i + 1) % tabs.length, ArrowLeft: (i - 1 + tabs.length) % tabs.length, Home: 0, End: tabs.length - 1 }[key];
			if (next === undefined) return;
			event.preventDefault();
			select(tabs[next]);
		});
	}

	// Tooltips open on hover and on keyboard focus, stay open while the pointer
	// is on them, and close with Esc. The definition also sits in the DOM behind
	// aria-describedby, so the visible popup is only a copy.
	if (pop) {
		let current: HTMLElement | null = null;
		let dismissed: HTMLElement | null = null;
		let timer: number | undefined;

		const hide = () => {
			clearTimeout(timer);
			current = null;
			pop.hidden = true;
		};
		hideTip = hide;

		const show = (trigger: HTMLElement) => {
			if (dismissed === trigger) return;
			clearTimeout(timer);
			current = trigger;
			pop.textContent = document.getElementById(trigger.getAttribute("aria-describedby") ?? "")?.textContent ?? "";
			pop.hidden = false;
			const rect = trigger.getBoundingClientRect();
			const { offsetWidth: w, offsetHeight: h } = pop;
			const above = rect.top - h - 6 >= 8;
			pop.style.top = `${above ? rect.top - h - 6 : rect.bottom + 6}px`;
			pop.style.left = `${Math.max(8, Math.min(rect.left + rect.width / 2 - w / 2, innerWidth - w - 8))}px`;
		};

		const trigger = (event: Event) => (event.target as Element | null)?.closest?.<HTMLElement>(".tip") ?? null;
		const hideSoon = () => {
			clearTimeout(timer);
			timer = window.setTimeout(hide, 150);
		};

		document.addEventListener("mouseover", (event) => {
			const t = trigger(event);
			if (t) show(t);
			else if (pop.contains(event.target as Node)) clearTimeout(timer);
		});
		document.addEventListener("mouseout", (event) => {
			const t = trigger(event);
			if (t) {
				if (document.activeElement !== t) dismissed = null;
				if (document.activeElement !== t) hideSoon();
			} else if (pop.contains(event.target as Node)) hideSoon();
		});
		document.addEventListener("focusin", (event) => {
			const t = trigger(event);
			if (t) show(t);
		});
		document.addEventListener("focusout", (event) => {
			if (trigger(event)) {
				dismissed = null;
				hide();
			}
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && current) {
				dismissed = current;
				hide();
			}
		});
		addEventListener("resize", hide);
		addEventListener("scroll", hide, true);
	}
</script>
