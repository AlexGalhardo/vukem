---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Vukem — From idea to application</title><meta name="description" content="Build APIs and full-stack applications with Vukem, a Go web framework. See a real personal finance SaaS come to life." /><link rel="canonical" href="https://vukem.dev/" /><link rel="icon" href="/icon.svg" /><meta name="theme-color" content="#07090d" /><meta property="og:title" content="Vukem — From idea to application" /><meta property="og:description" content="Your next product starts here. A Go framework for APIs and full-stack apps." /><meta property="og:image" content="https://vukem.dev/media/vukem-launch-poster.jpg" /></head>
<body>
<div id="scene" aria-hidden="true"></div>
<main>
<header><span class="wordmark">vukem<span class="dot">.</span></span><span class="edition">GO FRAMEWORK <span class="status"></span> OPEN SOURCE</span></header>
<section class="hero" aria-labelledby="headline">
<div class="intro"><p class="eyebrow"><span>01 / BUILD SOMETHING REAL</span></p><h1 id="headline">From idea.<br />To <em>application.</em></h1><p class="description">A Go framework for the things you want to build.<br class="desktop" /> APIs. Full-stack apps. Your next product.</p><a class="cta" href="/docs/introduction/">Read Docs <span aria-hidden="true">↗</span></a><p class="command"><span aria-hidden="true">$</span> vukem new money --example finance<span class="cursor" aria-hidden="true">_</span></p></div>
<figure class="trailer"><figcaption><span>FROM IDEA TO APPLICATION</span><span>FILM / 02:00</span></figcaption><video controls playsinline preload="metadata" poster="/media/vukem-launch-poster.jpg" aria-label="Vukem launch film: a personal finance application built with Vukem"><source src="/media/vukem-launch-horizontal.mp4" type="video/mp4" /><track kind="captions" src="/media/vukem-launch.vtt" srclang="en" label="English on-screen text" />Your browser does not support HTML video.</video><div class="caption"><span class="status"></span> Real application. Real framework. <span class="caption-end">GO + REACT + INERTIA</span></div></figure>
</section>
<footer><span>LESS FRICTION. MORE BUILDING.</span><span>BUILT ON net/http <span class="slash">/</span> MADE FOR YOUR NEXT IDEA</span></footer>
</main>
<script>import '../scripts/landing.js';</script>
<style is:global>
*{box-sizing:border-box}html,body{margin:0;background:#07090d;color:#edf1f5;font-family:Inter,sans-serif}body{height:100dvh}#scene{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 75% 30%,#112b333d,transparent 65%)}#scene canvas{display:block;width:100%;height:100%}main{position:relative;min-height:0;height:100dvh;padding:32px 5vw 24px;display:flex;flex-direction:column}header,footer{display:flex;justify-content:space-between;align-items:center;flex-shrink:0}.wordmark{font-size:35px;font-weight:600;letter-spacing:-2px}.dot{color:#38e1ff}.edition,.eyebrow,footer,figcaption,.command,.caption{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1.4px;color:#8494a7}.edition{display:flex;align-items:center;gap:14px}.status{display:inline-block;width:5px;height:5px;border-radius:50%;background:#38e1ff;box-shadow:0 0 10px #38e1ff70}.hero{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:5vw}.eyebrow{color:#38e1ff;margin:0 0 30px}h1{font-size:clamp(42px,5.2vw,100px);line-height:1.08;font-weight:600;letter-spacing:-.065em;margin:0}h1 em{font-style:normal;color:#38e1ff}.description{color:#9caabb;font-size:clamp(13px,1.2vw,18px);line-height:1.8;margin:25px 0 30px}.cta{display:inline-flex;align-items:center;gap:45px;background:#edf1f5;color:#07090d;border:1px solid #edf1f5;border-radius:4px;padding:15px 22px;font-weight:600;font-size:13px;text-decoration:none;transition:background .2s,transform .2s}.cta:hover{background:#38e1ff;transform:translateY(-2px)}.cta:focus-visible{outline:3px solid #38e1ff;outline-offset:6px}.command{margin:28px 0 0;font-size:10px;letter-spacing:0}.command>span:first-child{color:#38e1ff;margin-right:9px}.cursor{animation:blink 1.2s steps(1) infinite}.trailer{margin:0;min-width:0;transform:perspective(1400px) rotateY(-4deg);border:1px solid #293743;background:#0c111ae8;border-radius:8px;padding:14px;box-shadow:0 30px 100px #0008}figcaption{display:flex;justify-content:space-between;font-size:8px;letter-spacing:1px;margin:0 0 14px}video{display:block;width:100%;aspect-ratio:16/9;background:#07090d;border-radius:3px}.caption{display:flex;gap:8px;align-items:center;font-size:8px;letter-spacing:0;margin-top:13px}.caption-end{margin-left:auto;color:#597182;font-size:7px}footer{border-top:1px solid #23303a;padding-top:18px;font-size:8px;letter-spacing:1px}.slash{color:#38e1ff;margin:0 15px}@keyframes blink{50%{opacity:0}}
@media(max-width:760px){main{padding:max(20px,env(safe-area-inset-top)) 7vw max(16px,env(safe-area-inset-bottom))}.wordmark{font-size:29px}.edition{font-size:7px;gap:8px;letter-spacing:.5px}.hero{grid-template-columns:1fr;gap:20px;align-content:center}.eyebrow{font-size:8px;margin-bottom:15px}h1{font-size:clamp(38px,9.8vw,65px)}.description{font-size:12px;margin:15px 0 20px;line-height:1.6}.cta{padding:12px 19px;font-size:12px}.command{font-size:8px;margin-top:16px}.trailer{transform:none;padding:10px;max-width:540px;width:100%;justify-self:center}figcaption{font-size:7px;margin-bottom:8px}.caption{font-size:7px;margin-top:8px}.caption-end{display:none}footer{font-size:6px;padding-top:12px;letter-spacing:.5px}footer>span:last-child{display:none}.desktop{display:none}}
@media(max-height:700px) and (min-width:761px){main{padding-top:18px;padding-bottom:16px}h1{font-size:clamp(38px,5vw,70px)}.eyebrow{margin-bottom:18px}.description{margin:15px 0 20px}.command{margin-top:18px}}
@media(max-height:700px) and (max-width:760px){main{padding-top:14px;padding-bottom:10px}.hero{gap:14px}.description{margin:10px 0 12px}.eyebrow{margin-bottom:10px}.command{display:none}h1{font-size:36px}.trailer{max-width:340px}footer{padding-top:9px}}
@media(orientation:landscape) and (max-height:500px){main{padding:12px 5vw}header .wordmark{font-size:24px}.hero{grid-template-columns:1fr 1fr;gap:4vw}.eyebrow{font-size:7px;margin-bottom:12px}h1{font-size:34px}.description{font-size:11px;margin:12px 0}.command{display:none}.cta{padding:10px 15px}.trailer{max-width:none}footer{padding-top:8px}.caption{font-size:6px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.trailer{transform:none}}
</style>
</body></html>
