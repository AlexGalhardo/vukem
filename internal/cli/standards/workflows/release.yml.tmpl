name: release

# Changelog section to a GitHub release. GoReleaser runs only when the
# repository has a GoReleaser config. An application that does not ship
# CLI archives still gets release notes.
#
# The body is the CHANGELOG.md section for the tag. An empty or missing
# section fails the job. There is no placeholder body.
#
# workflow_dispatch is the recovery path when a tag push started no run.
# Push version tags one at a time.
on:
  push:
    tags: ["v*"]
  workflow_dispatch:
    inputs:
      version:
        description: "Version tag to publish (vX.Y.Z). The tag must already be pushed."
        required: true

permissions:
  contents: read

jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    outputs:
      tag: ${{ "{{" }} steps.tag.outputs.tag {{ "}}" }}
    steps:
      - name: Resolve the tag
        id: tag
        env:
          INPUT_VERSION: ${{ "{{" }} inputs.version {{ "}}" }}
          REF_NAME: ${{ "{{" }} github.ref_name {{ "}}" }}
        run: |
          tag="${INPUT_VERSION:-$REF_NAME}"
          case "$tag" in
            v[0-9]*.[0-9]*.[0-9]*) ;;
            *)
              echo "::error::not a version tag: $tag"
              exit 1
              ;;
          esac
          echo "tag=$tag" >>"$GITHUB_OUTPUT"

      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: refs/tags/${{ "{{" }} steps.tag.outputs.tag {{ "}}" }}
          persist-credentials: false

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
          cache-dependency-path: go.sum

      - name: Extract the changelog section
        env:
          TAG: ${{ "{{" }} steps.tag.outputs.tag {{ "}}" }}
        run: go run ./scripts/release-notes.go "$TAG"

      - name: Publish the release
        env:
          GH_TOKEN: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}
          TAG: ${{ "{{" }} steps.tag.outputs.tag {{ "}}" }}
        run: |
          if gh release view "$TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            gh release edit "$TAG" --notes-file release-notes.md --repo "$GITHUB_REPOSITORY"
          else
            gh release create "$TAG" --verify-tag --title "$TAG" \
              --notes-file release-notes.md --repo "$GITHUB_REPOSITORY"
          fi

  binaries:
    name: GoReleaser
    runs-on: ubuntu-latest
    needs: release
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: refs/tags/${{ "{{" }} needs.release.outputs.tag {{ "}}" }}
          persist-credentials: false

      - name: GoReleaser config
        id: goreleaser
        run: |
          if [ -f .config/goreleaser.yaml ] || [ -f .goreleaser.yaml ]; then
            echo "present=true" >>"$GITHUB_OUTPUT"
          else
            echo "present=false" >>"$GITHUB_OUTPUT"
          fi

      # Skipped when the repository does not ship CLI archives.
      - name: Run GoReleaser
        if: steps.goreleaser.outputs.present == 'true'
        uses: goreleaser/goreleaser-action@e24998b8b67b290c2fa8b7c14fcfa7de2c5c9b8c # v7.1.0
        with:
          version: v2.18.2
          args: release --clean
        env:
          GITHUB_TOKEN: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}

  image:
    name: Publish the image
    runs-on: ubuntu-latest
    needs: release
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: refs/tags/${{ "{{" }} needs.release.outputs.tag {{ "}}" }}
          persist-credentials: false

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
          cache-dependency-path: go.sum

      # Same fail-closed notes check as the release job. A tag with no
      # section does not push an image.
      - name: Extract the changelog section
        env:
          TAG: ${{ "{{" }} needs.release.outputs.tag {{ "}}" }}
        run: go run ./scripts/release-notes.go "$TAG"

      - uses: docker/setup-buildx-action@d7f5e7f509e45cec5c76c4d5afdd7de93d0b3df5 # v4.1.0

      - uses: docker/login-action@650006c6eb7dba73a995cc03b0b2d7f5ca915bee # v4.2.0
        with:
          registry: ghcr.io
          username: ${{ "{{" }} github.actor {{ "}}" }}
          password: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}

      - name: Image name
        id: image
        run: echo "name=ghcr.io/$(echo "$GITHUB_REPOSITORY" | tr '[:upper:]' '[:lower:]')" >>"$GITHUB_OUTPUT"

      - name: Build and push
        id: push
        uses: docker/build-push-action@bcafcacb16a39f128d818304e6c9c0c18556b85f # v7.1.0
        with:
          context: .
          push: true
          tags: ${{ "{{" }} steps.image.outputs.name {{ "}}" }}:${{ "{{" }} needs.release.outputs.tag {{ "}}" }}
          provenance: mode=max

      - uses: actions/attest-build-provenance@a2bbfa25375fe432b6a289bc6b6cd05ecd0c4c32 # v4.1.0
        with:
          subject-name: ${{ "{{" }} steps.image.outputs.name {{ "}}" }}
          subject-digest: ${{ "{{" }} steps.push.outputs.digest {{ "}}" }}
          push-to-registry: true
