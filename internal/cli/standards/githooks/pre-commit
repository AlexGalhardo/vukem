#!/bin/sh
# Secret scanning, then formatting and vet, on the staged changes only.
# Installed by `vukem new --standards`; bypass with `git commit --no-verify`.
set -eu

# Betterleaks reads .betterleaks.toml. Without the binary the hook says so and
# goes on: CI runs the same scan and fails there, so nothing passes silently.
if command -v betterleaks >/dev/null 2>&1; then
	betterleaks git --pre-commit --staged --no-banner --redact
else
	echo "pre-commit: betterleaks not installed, secret scan skipped (CI still runs it)." >&2
	echo "pre-commit: install it from https://github.com/betterleaks/betterleaks/releases" >&2
fi

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -z "$staged" ]; then
	exit 0
fi

# shellcheck disable=SC2086 # the file list has to split into arguments
unformatted=$(gofmt -l $staged)
if [ -n "$unformatted" ]; then
	echo "pre-commit: gofmt -w these files, then stage them again:" >&2
	echo "$unformatted" >&2
	exit 1
fi

go vet ./...
