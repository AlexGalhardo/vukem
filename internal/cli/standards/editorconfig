root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# YAML is indentation-sensitive and forbids hard tabs; Markdown nesting is
# counted in spaces and markdownlint rejects tabs (MD010).
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2

# The JavaScript toolchain (package managers, Vite, Prettier) rewrites these
# files with two spaces, so matching it keeps diffs small.
[*.{js,mjs,cjs,ts,tsx,jsx,vue,svelte,json,jsonc}]
indent_style = space
indent_size = 2

[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf
