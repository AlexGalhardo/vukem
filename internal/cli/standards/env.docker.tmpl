
# docker compose (compose.yaml) runs the app with a mail catcher: it sets
# MAIL_MAILER=smtp, SMTP_HOST=mailpit and SMTP_PORT=1025, and the inbox is at
# http://localhost:8025. Nothing to add here for mail.
{{- if .Database}}
#
# Compose also starts PostgreSQL. To use it instead of SQLite, uncomment the
# line below, register the driver in bootstrap/app.go
# (vukem.WithDatabaseDrivers(postgres.Driver())) and add its module:
# go get github.com/AlexGalhardo/vukem/drivers/postgres && go mod tidy
# https://vukem.dev/docs/database/overview
# Use the POSTGRES_PASSWORD of compose.yaml in place of CHANGEME:
# DATABASE_URL=postgres://app:CHANGEME@postgres:5432/app?sslmode=disable
{{- end}}
