# Runs the ready-made {{.Example}} example from its published image:
#
#   docker compose up
#
# No source code, no build. Open http://localhost:3000.
# https://vukem.dev/docs/deployment/docker-and-railway
name: {{.Name}}

services:
  app:
    image: {{.Image}}
    # .env holds APP_KEY, generated by `vukem new --prebuilt`.
    env_file: [.env]
    environment:
      APP_URL: http://localhost:3000
{{- if .Finance}}
      MAIL_MAILER: smtp
      SMTP_HOST: mailpit
      SMTP_PORT: "1025"
      # The catcher speaks plain SMTP on a private network, not STARTTLS.
      SMTP_INSECURE: "true"
      MAIL_FROM: {{.Name}} <hello@localhost>
{{- end}}
    # Ports bind to 127.0.0.1 so the app stays off the network; drop the prefix to expose it on purpose.
    ports: ["127.0.0.1:3000:3000"]
    volumes: ["storage:/app/storage"]
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:3000/up"]
      interval: 5s
      timeout: 3s
      retries: 12
{{- if .Finance}}
    depends_on:
      mailpit:
        condition: service_started
      postgres:
        condition: service_healthy

  # The app starts on SQLite; this service is here for the day you switch to
  # PostgreSQL from a full-source project (`vukem new --example finance`).
  postgres:
    image: {{.PostgresImage}}
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: app
    ports: ["127.0.0.1:5432:5432"]
    # PostgreSQL 18 images want the mount one level above the data directory,
    # so pg_upgrade can move between major versions inside it.
    volumes: ["postgres:/var/lib/postgresql"]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 2s
      retries: 30

  # Mailpit accepts every message and shows it in a web inbox, so password
  # resets and verification emails are readable without a mail provider.
  mailpit:
    image: {{.MailpitImage}}
    # Only the web inbox is published; SMTP stays on the private network.
    ports: ["127.0.0.1:8025:8025"]
    environment:
      MP_SMTP_AUTH_ACCEPT_ANY: "1"
      MP_SMTP_AUTH_ALLOW_INSECURE: "1"
{{- end}}

volumes:
  storage:
{{- if .Finance}}
  postgres:
{{- end}}
