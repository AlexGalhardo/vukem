package mail

import "github.com/AlexGalhardo/vukem/mail"

// {{.Name}} is an email; send it with app.Mailer() then Send(ctx, {{.Name}}{...}).
type {{.Name}} struct {
	To   string
	Name string
	URL  string
}

// Envelope implements mail.Mailable.
func (m {{.Name}}) Envelope() mail.Envelope {
	return mail.Envelope{To: []string{m.To}, Subject: "{{.Name}}"}
}

// Content implements mail.Mailable: the React Email component
// resources/js/emails/{{.Snake}}.tsx, exported to resources/emails/{{.Snake}}.html.
func (m {{.Name}}) Content() mail.Content { return mail.React("{{.Snake}}", m) }
