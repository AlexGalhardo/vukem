package commands

import (
	"context"
	"fmt"

	vukem "github.com/AlexGalhardo/vukem"
)

// {{.Name}} is the "{{.Kebab}}" command: vukem {{.Kebab}}. Name the ctx
// parameter with the first call that needs it; anything doing I/O does.
func {{.Name}}() vukem.Command {
	return vukem.CommandFunc{
		CommandName: "{{.Kebab}}",
		Desc:        "Describe what {{.Kebab}} does",
		Fn: func(_ context.Context, app *vukem.App, args []string) error {
			fmt.Fprintln(app.Stdout(), "{{.Kebab}} ran with", args)
			return nil
		},
	}
}
