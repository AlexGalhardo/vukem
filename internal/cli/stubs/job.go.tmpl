package jobs

import (
	"context"
{{- if .App}}

	vukem "github.com/AlexGalhardo/vukem"
{{- end}}
)

// {{.Name}} is a queued job: q.Dispatch(ctx, jobs.{{.Name}}{...}). Its
// fields are stored as JSON, so keep them serializable.
type {{.Name}} struct{}

// Kind names the job's handler; keep it stable across deploys.
func ({{.Name}}) Kind() string { return "{{.Snake}}" }
{{if .App}}
// Handle{{.Name}} builds the job's handler from app (app.DB, app.Now,
// app.Mailer...). Returning an error retries the job with backoff.
func Handle{{.Name}}(app *vukem.App) func(ctx context.Context, j {{.Name}}) error {
	return func(ctx context.Context, j {{.Name}}) error {
		return nil
	}
}
{{- else}}
// Handle{{.Name}} runs the job. Returning an error retries it with backoff.
func Handle{{.Name}}(ctx context.Context, j {{.Name}}) error {
	return nil
}
{{- end}}
