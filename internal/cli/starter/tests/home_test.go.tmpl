package tests

import (
	"testing"

	"github.com/AlexGalhardo/golang-framework/lumektest"

	"{{.Module}}/bootstrap"
)

func TestHome(t *testing.T) {
	t.Parallel()

	app := lumektest.New(t, bootstrap.New)

	app.Client(t).Get("/").AssertOK().AssertSee("Your Lumek app is running")
	app.Client(t).Get("/up").AssertOK()
	app.Client(t).Get("/js/htmx.min.js").AssertOK()
}
