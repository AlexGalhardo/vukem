package tests

import (
	"net/url"
	"strconv"
	"testing"

	"github.com/AlexGalhardo/vukem/vukemtest"

	"{{.Module}}/app/models"
	"{{.Module}}/bootstrap"
	"{{.Module}}/database/factories"
)

func TestPostsCRUD(t *testing.T) {
	t.Parallel()

	app := vukemtest.New(t, bootstrap.New)
	c := app.Client(t)

	c.PostForm("/posts", url.Values{"title": {"Hello Vukem"}, "body": {"First post."}}).
		AssertRedirect("/posts/1").
		AssertSessionHas("success")

	vukemtest.AssertDatabaseHas(t, app, "posts", map[string]any{"title": "Hello Vukem"})

	c.Get("/posts/1").AssertOK().AssertSee("Hello Vukem").AssertSee("Post created.")
	c.Get("/posts").AssertOK().AssertSee("Hello Vukem")
	c.HTMX().Get("/posts?q=nothing").AssertOK().AssertFragment().AssertDontSee("Hello Vukem")

	app.Client(t).PostForm("/posts/1", url.Values{"_method": {"PUT"}, "title": {"Edited"}, "body": {""}}).
		AssertRedirect("/posts/1")
	vukemtest.AssertDatabaseHas(t, app, "posts", map[string]any{"title": "Edited"})

	app.Client(t).HTMX().Delete("/posts/1").AssertOK()
	vukemtest.AssertDatabaseCount(t, app, "posts", 0)

	app.Client(t).Get("/posts/1").AssertNotFound()
}

func TestPostsValidation(t *testing.T) {
	t.Parallel()

	app := vukemtest.New(t, bootstrap.New)

	app.Client(t).WithHeader("Referer", "/posts/create").
		PostForm("/posts", url.Values{"title": {"x"}}).
		AssertRedirect("/posts/create").
		AssertSessionHasErrors("title")

	vukemtest.AssertDatabaseCount(t, app, "posts", 0)
}

func TestPostsJSON(t *testing.T) {
	t.Parallel()

	app := vukemtest.New(t, bootstrap.New)
	api := app.Client(t).AcceptJSON()

	api.PostJSON("/posts", map[string]any{"title": "From the API", "body": "JSON"}).
		AssertCreated().
		AssertHeader("Location", "/posts/1").
		AssertJSONPath("title", "From the API")

	api.GetJSON("/posts").AssertOK().AssertJSONCount("data", 1)
	api.GetJSON("/posts/1").AssertOK().AssertJSONPath("id", 1)
	api.PutJSON("/posts/1", map[string]any{"title": "Renamed"}).AssertOK().AssertJSONPath("title", "Renamed")

	api.PostJSON("/posts", map[string]any{"title": "x"}).AssertJSONValidationErrors("title")
	api.GetJSON("/posts/99").AssertProblem(404)

	api.Delete("/posts/1").AssertNoContent()
	vukemtest.AssertDatabaseCount(t, app, "posts", 0)
}

func TestPostsSeederAndFactory(t *testing.T) {
	t.Parallel()

	app := vukemtest.New(t, bootstrap.New)
	if err := app.Seed(t.Context()); err != nil {
		t.Fatal(err)
	}

	vukemtest.AssertDatabaseCount(t, app, "posts", 10)

	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	post, err := factories.Post.State(func(p *models.Post) { p.Title = "Pinned" }).CreateOne(t.Context(), db)
	if err != nil {
		t.Fatal(err)
	}

	app.Client(t).Get("/posts/" + strconv.FormatInt(post.ID, 10)).AssertOK().AssertSee("Pinned")
}
