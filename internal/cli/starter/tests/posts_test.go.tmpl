package tests

import (
	"net/url"
	"testing"

	"github.com/AlexGalhardo/golang-framework/lumektest"

	"{{.Module}}/bootstrap"
)

func TestPostsCRUD(t *testing.T) {
	t.Parallel()

	app := lumektest.New(t, bootstrap.New)
	c := app.Client(t)

	c.PostForm("/posts", url.Values{"title": {"Hello Lumek"}, "body": {"First post."}}).
		AssertRedirect("/posts/1").
		AssertSessionHas("success")

	lumektest.AssertDatabaseHas(t, app, "posts", map[string]any{"title": "Hello Lumek"})

	c.Get("/posts/1").AssertOK().AssertSee("Hello Lumek").AssertSee("Post created.")
	c.Get("/posts").AssertOK().AssertSee("Hello Lumek")
	c.HTMX().Get("/posts?q=nothing").AssertOK().AssertFragment().AssertDontSee("Hello Lumek")

	app.Client(t).PostForm("/posts/1", url.Values{"_method": {"PUT"}, "title": {"Edited"}, "body": {""}}).
		AssertRedirect("/posts/1")
	lumektest.AssertDatabaseHas(t, app, "posts", map[string]any{"title": "Edited"})

	app.Client(t).HTMX().Delete("/posts/1").AssertOK()
	lumektest.AssertDatabaseCount(t, app, "posts", 0)

	app.Client(t).Get("/posts/1").AssertNotFound()
}

func TestPostsValidation(t *testing.T) {
	t.Parallel()

	app := lumektest.New(t, bootstrap.New)

	app.Client(t).WithHeader("Referer", "/posts/create").
		PostForm("/posts", url.Values{"title": {"x"}}).
		AssertRedirect("/posts/create").
		AssertSessionHasErrors("title")

	lumektest.AssertDatabaseCount(t, app, "posts", 0)
}

func TestPostsJSON(t *testing.T) {
	t.Parallel()

	app := lumektest.New(t, bootstrap.New)
	api := app.Client(t).AcceptJSON()

	api.PostJSON("/posts", map[string]any{"title": "From the API", "body": "JSON"}).
		AssertCreated().
		AssertHeader("Location", "/posts/1").
		AssertJSONPath("title", "From the API")

	api.GetJSON("/posts").AssertOK().AssertJSONCount("data", 1)
	api.GetJSON("/posts/1").AssertOK().AssertJSONPath("id", 1)
	api.PutJSON("/posts/1", map[string]any{"title": "Renamed"}).AssertOK().AssertJSONPath("title", "Renamed")

	api.PostJSON("/posts", map[string]any{"title": "x"}).AssertJSONValidationErrors("title")
	api.GetJSON("/posts/99").AssertProblem(404)

	api.Delete("/posts/1").AssertNoContent()
	lumektest.AssertDatabaseCount(t, app, "posts", 0)
}
