// Package routes declares the HTTP routes.
package routes

import (
	lumek "github.com/AlexGalhardo/golang-framework"
	"github.com/AlexGalhardo/golang-framework/middleware"
	"github.com/AlexGalhardo/golang-framework/router"

	"{{.Module}}/app/controllers"
	"{{.Module}}/resources"
)

// Web registers the browser routes. lumek route:list shows them.
func Web(r *router.Router, app *lumek.App) error {
	if err := lumek.DefaultMiddleware(app, r); err != nil {
		return err
	}

	r.UseServer(middleware.StaticFS(resources.Public(), middleware.StaticConfig{Prefix: "/"}))

	db, err := app.DB()
	if err != nil {
		return err
	}

	r.Get("/", controllers.Home).Name("home")
	r.Resource("posts", controllers.NewPostController(db))

	return nil
}
