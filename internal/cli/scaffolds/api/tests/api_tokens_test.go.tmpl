	"time"

	"github.com/AlexGalhardo/vukem/orm"
	"github.com/AlexGalhardo/vukem/vukemtest"

	"{{.Module}}/app/accounts"
	"{{.Module}}/app/controllers/apiv1"
	"{{.Module}}/app/models"
	"{{.Module}}/bootstrap"
)

// createAPIUser creates a user directly, with a verified email or not.
func createAPIUser(t *testing.T, app *vukemtest.App, email string, verified bool) {
	t.Helper()

	acc, err := accounts.New(app.App)
	if err != nil {
		t.Fatal(err)
	}

	h, err := acc.Hasher.Make(testPassword)
	if err != nil {
		t.Fatal(err)
	}

	u := models.User{Name: "API User", Email: email, Password: h}
	u.EmailVerifiedAt.V, u.EmailVerifiedAt.Valid = time.Now().UTC(), verified

	if err := orm.Create(t.Context(), acc.DB, &u); err != nil {
		t.Fatal(err)
	}
}

// apiToken creates a verified user directly and returns a token carrying
// abilities. With none, the key is issued with no abilities at all: the
// endpoint grants only what the request asks for.
func apiToken(t *testing.T, app *vukemtest.App, email string, abilities ...string) string {
	t.Helper()

	createAPIUser(t, app, email, true)

	body := map[string]any{"email": email, "password": testPassword, "device_name": "cli"}
	if len(abilities) > 0 {
		body["abilities"] = abilities
	}

	r := app.Client(t).PostJSON("/api/v1/tokens", body).AssertCreated().AssertJSONPath("type", "Bearer")

	tok, _ := r.JSONPath("token")
	s, _ := tok.(string)

	return s
}

// A token is a login: an unverified address may belong to someone else,
// so the right password is not enough.
func TestAPITokenNeedsVerifiedEmail(t *testing.T) {
	t.Parallel()

	app := vukemtest.New(t, bootstrap.New)
	createAPIUser(t, app, "squatter@example.com", false)

	app.Client(t).PostJSON("/api/v1/tokens", map[string]any{
		"email": "squatter@example.com", "password": testPassword, "device_name": "cli",
	}).AssertForbidden()
	vukemtest.AssertDatabaseCount(t, app, "access_tokens", 0)
}

func TestTokenLifecycle(t *testing.T) {
	t.Parallel()

	app := vukemtest.New(t, bootstrap.New)
	token := apiToken(t, app, "dev@example.com", apiv1.AbilityRead)

	api := app.Client(t).WithToken(token)
	api.GetJSON("/api/v1/me").AssertOK().AssertJSONPath("email", "dev@example.com")

	app.Client(t).GetJSON("/api/v1/me").AssertUnauthorized()
	app.Client(t).PostJSON("/api/v1/tokens", map[string]any{
		"email": "dev@example.com", "password": "wrong", "device_name": "cli",
	}).AssertJSONValidationErrors("email")

	api.Delete("/api/v1/tokens/current").AssertNoContent()
	app.Client(t).WithToken(token).GetJSON("/api/v1/me").AssertUnauthorized()
}

// Secure by default: a key carries only the abilities the request asked
// for, so one issued without AbilityRead cannot read. Add an ability to
// apiv1.Abilities, gate a route on it, and every existing key is refused.
func TestAPITokenWithoutAbilityIsRefused(t *testing.T) {
	t.Parallel()

	app := vukemtest.New(t, bootstrap.New)
	token := apiToken(t, app, "narrow@example.com")

	app.Client(t).WithToken(token).GetJSON("/api/v1/me").AssertForbidden()
}

// An ability the app does not define is refused, wildcards included.
func TestAPITokenRejectsUnknownAbility(t *testing.T) {
	t.Parallel()

	app := vukemtest.New(t, bootstrap.New)
	createAPIUser(t, app, "wide@example.com", true)

	for _, ability := range []string{"*", "admin"} {
		app.Client(t).PostJSON("/api/v1/tokens", map[string]any{
			"email": "wide@example.com", "password": testPassword,
			"device_name": "cli", "abilities": []string{ability},
		}).AssertUnprocessable()
	}

	vukemtest.AssertDatabaseCount(t, app, "access_tokens", 0)
}
