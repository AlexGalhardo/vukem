package accounts

import (
	"context"
	"crypto/sha256"
	"encoding/hex"
	"errors"
	"fmt"
	"strings"
	"time"

	"github.com/AlexGalhardo/vukem/database"
	"github.com/AlexGalhardo/vukem/orm"

	"{{.Module}}/app/mail"
	"{{.Module}}/app/models"
	"{{.Module}}/app/requests"
)

// Register signs in.Email up without revealing whether it already has an
// account: the caller always answers "check your email" and never logs in.
// A new address gets the account and a verification mail; an existing one
// gets a notice ("sign in or reset your password", at most one per hour
// per address) and nothing is created or changed. Both paths hash the
// password and queue one mail, so they take about the same time. It
// reports whether an account was created.
func (a *Accounts) Register(ctx context.Context, in requests.Register) (bool, error) {
	email := strings.ToLower(strings.TrimSpace(in.Email))

	h, err := a.Hasher.Make(in.Password)
	if err != nil {
		return false, err
	}

	existing, err := orm.QueryOf[models.User](a.DB).Where("email", email).First(ctx)
	if err == nil {
		return false, a.notifyExisting(ctx, existing)
	}

	if !errors.Is(err, orm.ErrNotFound) {
		return false, err
	}

	u := models.User{Name: in.Name, Email: email, Password: h}
	if err := orm.Create(ctx, a.DB, &u); err != nil {
		// A concurrent sign-up with the same email won the unique index.
		if existing, findErr := orm.QueryOf[models.User](a.DB).Where("email", email).First(ctx); findErr == nil {
			return false, a.notifyExisting(ctx, existing)
		}

		return false, err
	}

	return true, a.SendVerification(ctx, u)
}

// notifyExisting tells the owner of an existing account that someone tried
// to sign up with it, at most once per hour per address, so the form cannot
// be used to flood a mailbox. The cache key holds a hash, not the address.
func (a *Accounts) notifyExisting(ctx context.Context, u models.User) error {
	c, err := a.cache()
	if err != nil {
		return err
	}

	sum := sha256.Sum256([]byte(u.Email))

	n, err := c.Increment(ctx, "register:exists:"+hex.EncodeToString(sum[:]), 1, time.Hour)
	if err != nil {
		return err
	}

	if n > 1 {
		return nil
	}

	return a.Mailer.SendLater(ctx, mail.AccountExists{
		User: u, LoginLink: a.URL + "/login", ResetLink: a.URL + "/forgot-password",
		Subject: a.T(ctx, "auth.mail.account_exists_subject"),
	})
}

// SendVerification emails a signed link that verifies u's address. The
// mail is queued (SendLater), so sign-up does not wait for the mail server.
func (a *Accounts) SendVerification(ctx context.Context, u models.User) error {
	link, err := a.Signer.Sign(fmt.Sprintf("%s/email/verify/%d", a.URL, u.ID), a.VerifyTTL)
	if err != nil {
		return err
	}

	return a.Mailer.SendLater(ctx, mail.VerifyEmail{User: u, Link: link, Subject: a.T(ctx, "auth.mail.verify_subject")})
}

// MarkVerified sets email_verified_at using ex (a.DB, or the transaction
// in progress: SQLite has a single writer connection).
func (a *Accounts) MarkVerified(ctx context.Context, ex database.Executor, u *models.User) error {
	if u.EmailVerified() {
		return nil
	}

	u.EmailVerifiedAt = orm.NullTime{}
	u.EmailVerifiedAt.V, u.EmailVerifiedAt.Valid = a.now().UTC(), true

	_, err := orm.QueryOf[models.User](ex).Where("id", u.ID).Update(ctx, orm.Set{"email_verified_at": u.EmailVerifiedAt.V})

	return err
}

// UpdatePassword stores a new hash for u inside tx.
func (a *Accounts) updatePassword(ctx context.Context, tx database.Executor, id int64, password string) error {
	h, err := a.Hasher.Make(password)
	if err != nil {
		return err
	}

	_, err = orm.QueryOf[models.User](tx).Where("id", id).Update(ctx, orm.Set{"password": h})

	return err
}

func (a *Accounts) expired(created time.Time, ttl time.Duration) bool { return a.now().After(created.Add(ttl)) }
