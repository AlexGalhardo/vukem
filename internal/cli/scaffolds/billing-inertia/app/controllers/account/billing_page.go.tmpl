package account

import (
	"github.com/AlexGalhardo/vukem/auth"
	"github.com/AlexGalhardo/vukem/web"

	"{{.Module}}/app/models"
	"{{.Module}}/app/pages"
)

// Show renders the plans and the current subscription.
func (h *BillingHandlers) Show(c *web.Ctx) error {
	u, err := auth.User[models.User](c, "web")
	if err != nil {
		return err
	}

	page, err := h.page(c, u)
	if err != nil {
		return err
	}

	plans := make([]pages.BillingPlan, len(page.Plans))
	for i, p := range page.Plans {
		plans[i] = pages.BillingPlan(p)
	}

	return pages.Billing.Render(c, pages.BillingProps{
		Plans:        plans,
		Subscription: (*pages.BillingSubscription)(page.Subscription),
		Subscribed:   page.Subscribed,
		Checkout:     c.Query("checkout") == "success",
	})
}
