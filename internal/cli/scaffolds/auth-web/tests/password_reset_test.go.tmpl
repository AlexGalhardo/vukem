package tests

import (
	"net/url"
	"testing"

	vukem "github.com/AlexGalhardo/vukem"
	"github.com/AlexGalhardo/vukem/queue"
	"github.com/AlexGalhardo/vukem/vukemtest"

	"{{.Module}}/bootstrap"
)

// The reset form answers alike for known and unknown emails, and the
// reset mail goes through the queue instead of being sent during the
// request, so neither the answer nor its timing reveals who has an account.
func TestPasswordResetAnswersAlike(t *testing.T) {
	t.Parallel()

	fake := queue.NewFake()
	app := vukemtest.New(t, bootstrap.New, vukemtest.Options{
		AppOptions: []vukem.Option{vukem.WithQueueDriver(fake)},
	})
	register(t, app, app.Client(t), "dee@example.com")

	mailJobs := func() int {
		n := 0

		for _, m := range fake.Messages() {
			if m.Kind == vukem.MailJobKind {
				n++
			}
		}

		return n
	}

	sentBefore := len(app.Mails().SentTo("dee@example.com"))

	for _, tc := range []struct {
		email string
		jobs  int
	}{
		{"nobody@example.com", 0},
		{"dee@example.com", 1},
	} {
		c := app.Client(t)
		c.PostForm("/forgot-password", url.Values{"email": {tc.email}}).AssertRedirect("/forgot-password")
		c.Get("/forgot-password").AssertOK().AssertSee("If that email has an account")

		if got := mailJobs(); got != tc.jobs {
			t.Errorf("after %s: %d queued reset mails, want %d", tc.email, got, tc.jobs)
		}
	}

	if len(app.Mails().SentTo("dee@example.com")) != sentBefore {
		t.Error("the reset mail was sent during the request instead of queued")
	}
}
