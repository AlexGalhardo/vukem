package tests

import "testing"

func TestBillingPage(t *testing.T) {
	t.Parallel()

	f := newFakeStripe(t)
	app := billingApp(t, f)
	u := newUser(t, app, "page@example.com")
	c := app.Client(t).ActingAs("web", u)

	c.Get("/billing").AssertOK().
		AssertSee("no subscription yet").
		AssertSee(`action="/billing/checkout/{{.Plan}}"`).
		AssertSee("Subscribe to {{.PlanLabel}}")

	setCustomer(t, app, u)
	f.setSubscription("active", "price_{{.Plan}}")
	postWebhook(t, app, "evt_1", "customer.subscription.created", map[string]any{"id": "sub_1"}).AssertOK()

	c.Get("/billing").AssertOK().
		AssertSee("<strong>{{.PlanLabel}}</strong> (active), renews on").
		AssertSee("Manage billing").
		AssertDontSee("Subscribe to")
}
