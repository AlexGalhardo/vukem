package resources

import (
	"time"

	"{{.Module}}/app/models"
)

// TaskJSON is the wire format of models.Task.
type TaskJSON struct {
	ID        int64     `json:"id"`
	Title     string    `json:"title"`
	Done      bool      `json:"done"`
	CreatedAt time.Time `json:"created_at"`
}

// Task transforms one model.
func Task(t models.Task) TaskJSON {
	return TaskJSON{ID: t.ID, Title: t.Title, Done: t.Done, CreatedAt: t.CreatedAt}
}
