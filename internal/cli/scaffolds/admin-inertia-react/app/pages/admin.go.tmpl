package pages

import "github.com/AlexGalhardo/vukem/inertia"

// The typed pages of vukem install:admin -stack inertia.
var (
	AdminDashboard    = inertia.Define[AdminDashboardProps]("Admin/Dashboard")
	AdminResourceList = inertia.Define[AdminResourceListProps]("Admin/ResourceList")
	AdminResourceShow = inertia.Define[AdminResourceShowProps]("Admin/ResourceShow")
)

// AdminDashboardProps are the props of Admin/Dashboard: the URL the page
// fetches its data from.
type AdminDashboardProps struct {
	DataURL string `json:"dataUrl"`
}

// AdminResourceListProps are the props of Admin/ResourceList.
type AdminResourceListProps struct {
	Slug    string `json:"slug"`
	DataURL string `json:"dataUrl"`
}

// AdminResourceShowProps are the props of Admin/ResourceShow.
type AdminResourceShowProps struct {
	Slug    string `json:"slug"`
	ID      string `json:"id"`
	DataURL string `json:"dataUrl"`
}
