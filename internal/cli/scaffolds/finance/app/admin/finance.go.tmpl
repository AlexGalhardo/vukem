package admin

import (
	"context"

	vadmin "github.com/AlexGalhardo/vukem/admin"
	"github.com/AlexGalhardo/vukem/z"

	"{{.Module}}/app/models"
)

// The finance panel is for support: it lists and shows users, workspaces and
// subscriptions and changes nothing. Their policies grant ViewAny and View
// only, so the create, edit and delete forms are denied. Passwords and Stripe
// ids carry json:"-" and never leave the database.

// User is the admin resource for models.User at /admin/users.
func User() *vadmin.Resource[models.User] {
	return vadmin.NewResource[models.User](z.Struct[models.User](z.Shape{})).
		Search("name", "email").
		List("id", "name", "email", "email_verified_at", "created_at")
}

// Workspace is the admin resource for models.Workspace at /admin/workspaces.
func Workspace() *vadmin.Resource[models.Workspace] {
	return vadmin.NewResource[models.Workspace](z.Struct[models.Workspace](z.Shape{})).
		Search("name").
		List("id", "name", "currency", "created_at")
}

// WorkspaceSubscription is the admin resource for models.WorkspaceSubscription
// at /admin/workspace-subscriptions.
func WorkspaceSubscription() *vadmin.Resource[models.WorkspaceSubscription] {
	return vadmin.NewResource[models.WorkspaceSubscription](z.Struct[models.WorkspaceSubscription](z.Shape{})).
		Filter("status", "active", "trialing", "past_due", "unpaid", "incomplete", "canceled").
		List("id", "workspace_id", "status", "unit_amount", "current_period_end", "cancel_at_period_end")
}

// UserPolicy lets admins read users.
type UserPolicy struct{ Admins Admins }

// ViewAny allows the list.
func (p UserPolicy) ViewAny(_ context.Context, u *models.User) bool { return p.Admins.Has(u) }

// View allows the detail page.
func (p UserPolicy) View(_ context.Context, u *models.User, _ *models.User) bool { return p.Admins.Has(u) }

// WorkspacePolicy lets admins read workspaces.
type WorkspacePolicy struct{ Admins Admins }

// ViewAny allows the list.
func (p WorkspacePolicy) ViewAny(_ context.Context, u *models.User) bool { return p.Admins.Has(u) }

// View allows the detail page.
func (p WorkspacePolicy) View(_ context.Context, u *models.User, _ *models.Workspace) bool {
	return p.Admins.Has(u)
}

// WorkspaceSubscriptionPolicy lets admins read subscriptions.
type WorkspaceSubscriptionPolicy struct{ Admins Admins }

// ViewAny allows the list.
func (p WorkspaceSubscriptionPolicy) ViewAny(_ context.Context, u *models.User) bool {
	return p.Admins.Has(u)
}

// View allows the detail page.
func (p WorkspaceSubscriptionPolicy) View(_ context.Context, u *models.User, _ *models.WorkspaceSubscription) bool {
	return p.Admins.Has(u)
}
