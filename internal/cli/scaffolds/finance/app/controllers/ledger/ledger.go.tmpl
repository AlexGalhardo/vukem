// ---- CSV import ----

func (h *Handlers) importPage(c *web.Ctx, preview *finance.Preview) error {
	accounts, err := h.Fin.Accounts(c.Context())
	if err != nil {
		return err
	}

	imports, err := h.Fin.Imports(c.Context())
	if err != nil {
		return err
	}

	lim, err := h.WS.Limits(c.Context())
	if err != nil {
		return err
	}

	return pages.Import.Render(c, pages.ImportProps{
		Accounts: accounts, Imports: imports, Preview: preview,
		DateFormats: finance.DateFormats, Enabled: lim.CSVImport,
	})
}

// Import shows the upload form and the latest imports.
func (h *Handlers) Import(c *web.Ctx) error { return h.importPage(c, nil) }

// UploadImport reads the statement and shows its columns to map.
func (h *Handlers) UploadImport(c *web.Ctx) error {
	if err := h.can(c, workspaces.AbilityManageData); err != nil {
		return err
	}

	file, header, err := c.FormFile("file")
	if err != nil {
		return errs.New(http.StatusUnprocessableEntity, "Choose a CSV file.")
	}

	defer file.Close()

	content, err := io.ReadAll(io.LimitReader(file, finance.MaxImportBytes+1))
	if err != nil {
		return err
	}

	preview, err := h.Fin.StartImport(c.Context(), id(c.FormValue("accountId")), header.Filename, content)
	if err != nil {
		return back(c, "/import", err)
	}

	return h.importPage(c, &preview)
}

// ConfirmImport queues the job that creates the transactions.
func (h *Handlers) ConfirmImport(c *web.Ctx) error {
	if err := h.can(c, workspaces.AbilityManageData); err != nil {
		return err
	}

	iid, err := c.ParamInt("import")
	if err != nil {
		return err
	}

	in, err := web.Parse(c, requests.ImportMappingSchema)
	if err != nil {
		return err
	}

	err = h.Fin.ConfirmImport(c.Context(), iid, finance.Mapping{
		Date: in.Date, Description: in.Description, Amount: in.Amount, Category: in.Category,
		DateFormat: in.DateFormat, Invert: in.Invert == "true",
	}, func(ctx context.Context, ws, imp int64) error {
		return h.Fin.Queue.Dispatch(ctx, jobs.ImportCSV{WorkspaceID: ws, ImportID: imp})
	})
	if err != nil {
		return back(c, "/import", err)
	}

	return done(c, "/import", "Import queued: it appears below when it finishes.")
}

// ---- workspace ----

func view(w models.Workspace) pages.WorkspaceView {
	return pages.WorkspaceView{ID: w.ID, Name: w.Name, Currency: w.Currency}
}

// Workspace shows the settings, the members and the invites.
func (h *Handlers) Workspace(c *web.Ctx) error {
	ws, err := h.WS.Current(c.Context())
	if err != nil {
		return err
	}

	members, err := h.WS.Members(c.Context())
	if err != nil {
		return err
	}

	invites, err := h.WS.Invites(c.Context())
	if err != nil {
		return err
	}

	lim, err := h.WS.Limits(c.Context())
	if err != nil {
		return err
	}

	return pages.Workspace.Render(c, pages.WorkspaceProps{
		WorkspaceDetails: view(ws), Members: members, Invites: invites, Limits: lim,
		CanManage: h.can(c, workspaces.AbilityManageMembers) == nil,
	})
}

// UpdateWorkspace renames the workspace and sets its currency.
func (h *Handlers) UpdateWorkspace(c *web.Ctx) error {
	if err := h.can(c, workspaces.AbilityManageMembers); err != nil {
		return err
	}

	in, err := web.Parse(c, requests.WorkspaceSchema)
	if err != nil {
		return err
	}

	if err := h.WS.Rename(c.Context(), in.Name, in.Currency); err != nil {
		return back(c, "/workspace", err)
	}

	return done(c, "/workspace", "Workspace saved.")
}

// CreateWorkspace makes another workspace owned by the user and switches to it.
func (h *Handlers) CreateWorkspace(c *web.Ctx) error {
	u, err := auth.User[models.User](c, "web")
	if err != nil {
		return err
	}

	in, err := web.Parse(c, requests.WorkspaceSchema)
	if err != nil {
		return err
	}

	ws, err := h.WS.Create(c.Context(), u, in.Name, in.Currency)
	if err != nil {
		return back(c, "/workspace", err)
	}

	if err := workspaces.Switch(c.Request(), ws.ID); err != nil {
		return err
	}

	return done(c, "/dashboard", "Workspace created.")
}

// SwitchWorkspace makes another workspace of the user the current one. The
// next request checks the membership, so a workspace that is not theirs is a 404.
func (h *Handlers) SwitchWorkspace(c *web.Ctx) error {
	wid, err := c.ParamInt("workspace")
	if err != nil {
		return err
	}

	if err := workspaces.Switch(c.Request(), wid); err != nil {
		return err
	}

	return c.Redirect("/dashboard")
}

// Invite emails an invitation.
func (h *Handlers) Invite(c *web.Ctx) error {
	if err := h.can(c, workspaces.AbilityManageMembers); err != nil {
		return err
	}

	u, err := auth.User[models.User](c, "web")
	if err != nil {
		return err
	}

	in, err := web.Parse(c, requests.InviteSchema)
	if err != nil {
		return err
	}

	if err := h.WS.Invite(c.Context(), u, in.Email, in.Role); err != nil {
		return back(c, "/workspace", err)
	}

	return done(c, "/workspace", "Invitation sent.")
}

// RemoveMember takes a member out of the workspace.
func (h *Handlers) RemoveMember(c *web.Ctx) error {
	if err := h.can(c, workspaces.AbilityManageMembers); err != nil {
		return err
	}

	uid, err := c.ParamInt("user")
	if err != nil {
		return err
	}

	if err := h.WS.RemoveMember(c.Context(), uid); err != nil {
		return back(c, "/workspace", err)
	}

	return done(c, "/workspace", "Member removed.")
}

// ShowInvite asks the signed-in user to confirm the invitation.
func (*Handlers) ShowInvite(c *web.Ctx) error {
	return pages.InviteAccept.Render(c, pages.InviteAcceptProps{Token: c.Param("token")})
}

// AcceptInvite joins the workspace of the invitation and switches to it.
func (h *Handlers) AcceptInvite(c *web.Ctx) error {
	u, err := auth.User[models.User](c, "web")
	if err != nil {
		return err
	}

	ws, err := h.WS.Accept(c.Context(), u, c.Param("token"))
	if err != nil {
		return err
	}

	if err := workspaces.Switch(c.Request(), ws.ID); err != nil {
		return err
	}

	return done(c, "/dashboard", "Welcome to "+ws.Name+".")
}
