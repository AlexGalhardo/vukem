// Handlers serves the finance pages.
type Handlers struct {
	WS  *workspaces.Service
	Fin *finance.Service
}

// New returns the handlers.
func New(ws *workspaces.Service, fin *finance.Service) *Handlers { return &Handlers{WS: ws, Fin: fin} }

func id(s string) int64 {
	n, _ := strconv.ParseInt(strings.TrimSpace(s), 10, 64)
	return n
}

// back answers a failed form: a plan limit sends the user to /billing, the
// other rule violations (422, 409, 413) show their message on the page the
// form is on. Everything else goes to the error handler.
func back(c *web.Ctx, path string, err error) error {
	if err == nil {
		return nil
	}

	e, ok := errors.AsType[*errs.HTTPError](err)
	if !ok || c.WantsJSON() {
		return err
	}

	switch e.Status {
	case http.StatusPaymentRequired:
		inertia.Flash(c, "error", e.Message)
		return c.Redirect("/billing")
	case http.StatusUnprocessableEntity, http.StatusConflict, http.StatusRequestEntityTooLarge:
		inertia.Flash(c, "error", e.Message)
		return c.Redirect(path)
	}

	return err
}

// transactionError keeps a browser modal open. A 422 is flashed as field
// errors and sent back to /transactions, which Inertia reports as onError
// so the typed values stay. JSON clients still receive the original status.
// Returning ValidationError would use the session hook and land on "/".
func transactionError(c *web.Ctx, err error) error {
	if c.WantsJSON() {
		return err
	}

	if verr, ok := errors.AsType[*errs.ValidationError](err); ok {
		return redirectTransactionFields(c, verr.Fields)
	}

	e, ok := errors.AsType[*errs.HTTPError](err)
	if !ok || e.Status != http.StatusUnprocessableEntity {
		return back(c, "/transactions", err)
	}

	return redirectTransactionFields(c, map[string][]string{transactionField(e.Message): {e.Message}})
}

func transactionField(message string) string {
	msg := strings.ToLower(message)

	switch {
	case strings.Contains(msg, "date"):
		return "date"
	case strings.Contains(msg, "kind"):
		return "kind"
	case strings.Contains(msg, "account"):
		return "accountId"
	case strings.Contains(msg, "category"):
		return "categoryId"
	case strings.Contains(msg, "description"):
		return "description"
	default:
		return "amount"
	}
}

func redirectTransactionFields(c *web.Ctx, fields map[string][]string) error {
	if s := c.Session(); s != nil {
		s.Flash(web.ErrorsKey, fields)

		if r := c.Request(); r != nil && r.PostForm != nil {
			s.Flash(web.OldInputKey, web.FormToMap(r.PostForm))
		}
	}

	for _, key := range []string{"date", "kind", "accountId", "categoryId", "description", "amount"} {
		if len(fields[key]) > 0 {
			inertia.Flash(c, "error", fields[key][0])

			break
		}
	}

	return c.Redirect("/transactions")
}

func done(c *web.Ctx, path, message string) error {
	inertia.Flash(c, "success", message)
	return c.Redirect(path)
}

// can fails with a 403 unless the role of the user holds ability.
func (h *Handlers) can(c *web.Ctx, ability string) error { return h.WS.Can(c.Context(), ability) }

// ---- dashboard ----

// Dashboard renders the charts of the month in ?month=YYYY-MM (default: this month).
func (h *Handlers) Dashboard(c *web.Ctx) error {
	month := c.Query("month")
	if len(month) != 7 {
		month = h.Fin.Month()
	}

	d, err := h.Fin.Dashboard(c.Context(), month)
	if err != nil {
		return err
	}

	return pages.Dashboard.Render(c, pages.DashboardProps{Dashboard: d})
}

// ---- transactions ----

// Transactions lists the transactions with the filters of the query string.
func (h *Handlers) Transactions(c *web.Ctx) error {
	f := pages.TxFilters{
		From: c.Query("from"), To: c.Query("to"), CategoryID: c.Query("categoryId"),
		AccountID: c.Query("accountId"), Kind: c.Query("kind"),
	}

	rows, err := h.Fin.Transactions(c.Context(), finance.TxFilter{
		From: f.From, To: f.To, CategoryID: id(f.CategoryID), AccountID: id(f.AccountID), Kind: f.Kind,
	})
	if err != nil {
		return err
	}

	accounts, err := h.Fin.Accounts(c.Context())
	if err != nil {
		return err
	}

	cats, err := h.Fin.Categories(c.Context())
	if err != nil {
		return err
	}

	return pages.Transactions.Render(c, pages.TransactionsProps{
		Transactions: rows, Accounts: accounts, Categories: cats, Filters: f, Today: h.Fin.Today(),
	})
}

// StoreTransaction records a transaction.
func (h *Handlers) StoreTransaction(c *web.Ctx) error {
	if err := h.can(c, workspaces.AbilityRecord); err != nil {
		return err
	}

	in, err := web.Parse(c, requests.TransactionSchema)
	if err != nil {
		return transactionError(c, err)
	}

	t, err := h.Fin.CreateTransaction(c.Context(), finance.TxInput{
		AccountID: id(in.AccountID), CategoryID: id(in.CategoryID), Kind: in.Kind, Amount: in.Amount,
		Description: in.Description, Date: in.Date,
	})
	if err != nil {
		return transactionError(c, err)
	}

	if c.WantsJSON() {
		return c.Created("/transactions", t)
	}

	return done(c, "/transactions", "Transaction added.")
}

// UpdateTransaction changes a transaction of the current workspace.
func (h *Handlers) UpdateTransaction(c *web.Ctx) error {
	if err := h.can(c, workspaces.AbilityRecord); err != nil {
		return err
	}
	tid, err := c.ParamInt("transaction")
	if err != nil {
		return err
	}
	in, err := web.Parse(c, requests.TransactionSchema)
	if err != nil {
		return transactionError(c, err)
	}
	row, err := h.Fin.UpdateTransaction(c.Context(), tid, finance.TxInput{
		AccountID:   id(in.AccountID),
		CategoryID:  id(in.CategoryID),
		Kind:        in.Kind,
		Amount:      in.Amount,
		Description: in.Description,
		Date:        in.Date,
	})
	if err != nil {
		return transactionError(c, err)
	}
	if c.WantsJSON() {
		return c.JSON(http.StatusOK, row)
	}
	return done(c, "/transactions", "Transaction updated.")
}

// DestroyTransaction deletes a transaction.
func (h *Handlers) DestroyTransaction(c *web.Ctx) error {
	if err := h.can(c, workspaces.AbilityRecord); err != nil {
		return err
	}

	tid, err := c.ParamInt("transaction")
	if err != nil {
		return err
	}

	if err := h.Fin.DeleteTransaction(c.Context(), tid); err != nil {
		return err
	}

	return done(c, "/transactions", "Transaction deleted.")
}

