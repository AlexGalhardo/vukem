// who is a signed-in user of a workspace, as the browser would be.
type who struct {
	User      models.User
	Workspace models.Workspace
	Client    *vukemtest.Client
}

func newApp(t *testing.T, env ...map[string]string) *vukemtest.App {
	t.Helper()

	opts := vukemtest.Options{Env: map[string]string{"ADMIN_EMAILS": "boss@example.com"}}
	for _, e := range env {
		maps.Copy(opts.Env, e)
	}

	return vukemtest.New(t, bootstrap.New, opts)
}

func newVerifiedUser(t *testing.T, app *vukemtest.App, name, email string) models.User {
	t.Helper()

	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	u := models.User{Name: name, Email: email, Password: "not used"}
	u.EmailVerifiedAt.V, u.EmailVerifiedAt.Valid = time.Now().UTC(), true

	if err := orm.Create(t.Context(), db, &u); err != nil {
		t.Fatal(err)
	}

	return u
}

func service(t *testing.T, app *vukemtest.App) *workspaces.Service {
	t.Helper()

	ws, err := workspaces.New(app.App)
	if err != nil {
		t.Fatal(err)
	}

	return ws
}

// signUp creates a verified user with a personal workspace and a browser
// signed in to it.
func signUp(t *testing.T, app *vukemtest.App, name, email string) who {
	t.Helper()

	u := newVerifiedUser(t, app, name, email)

	ws, err := service(t, app).Create(t.Context(), u, name+" household", "USD")
	if err != nil {
		t.Fatal(err)
	}

	return who{u, ws, browser(t, app, u, ws.ID)}
}

func browser(t *testing.T, app *vukemtest.App, u models.User, workspace int64) *vukemtest.Client {
	t.Helper()

	return app.Client(t).WithHeader("Sec-Fetch-Site", "same-origin").
		ActingAs("web", u).WithSession(map[string]any{workspaces.SessionKey: strconv.FormatInt(workspace, 10)})
}

// join adds u to the workspace of w with role.
func join(t *testing.T, app *vukemtest.App, w who, u models.User, role string) {
	t.Helper()

	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	m := models.Membership{WorkspaceID: w.Workspace.ID, UserID: u.ID, Role: role}
	if err := orm.Create(t.Context(), db, &m); err != nil {
		t.Fatal(err)
	}
}

// makePro gives the workspace a valid subscription.
func makePro(t *testing.T, app *vukemtest.App, w who) {
	t.Helper()

	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	sub := models.WorkspaceSubscription{
		WorkspaceID: w.Workspace.ID, StripeSubscriptionID: "sub_test_" + strconv.FormatInt(w.Workspace.ID, 10),
		Status: "active", PriceID: "price_pro", UnitAmount: 900,
	}
	if err := orm.Create(t.Context(), db, &sub); err != nil {
		t.Fatal(err)
	}
}

// firstAccount returns the id of the account the workspace was created with.
func firstAccount(t *testing.T, app *vukemtest.App, w who) int64 {
	t.Helper()

	return firstOf[models.Account](t, app, w, "").ID
}

func categoryID(t *testing.T, app *vukemtest.App, w who, name string) int64 {
	t.Helper()

	return firstOf[models.Category](t, app, w, name).ID
}

func firstOf[T any](t *testing.T, app *vukemtest.App, w who, name string) T {
	t.Helper()

	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	q := workspaces.Scoped[T](workspaces.WithTenant(t.Context(), w.Workspace.ID), db)
	if name != "" {
		q = q.Where("name", name)
	}

	v, err := q.First(t.Context())
	if err != nil {
		t.Fatal(err)
	}

	return v
}

func addTransaction(t *testing.T, w who, account, category int64, kind, amount, date string) *vukemtest.Response {
	t.Helper()

	form := url.Values{
		"accountId": {strconv.FormatInt(account, 10)}, "kind": {kind}, "amount": {amount},
		"description": {"test"}, "date": {date},
	}
	if category > 0 {
		form.Set("categoryId", strconv.FormatInt(category, 10))
	}

	return w.Client.PostForm("/transactions", form)
}

// inviteRe finds the invitation path in the HTML of the mail.
var inviteRe = regexp.MustCompile(`/invites/[A-Za-z0-9]+`)

func putForm(c *vukemtest.Client, target string, form url.Values) *vukemtest.Response {
	return c.Do(http.MethodPut, target, strings.NewReader(form.Encode()), "application/x-www-form-urlencoded")
}

func today() string { return time.Now().UTC().Format("2006-01-02") }

func count[T any](t *testing.T, app *vukemtest.App, w who) int64 {
	t.Helper()

	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	n, err := workspaces.Scoped[T](workspaces.WithTenant(t.Context(), w.Workspace.ID), db).Count(t.Context())
	if err != nil {
		t.Fatal(err)
	}

	return n
}

// ---- the first slice: sign up, a workspace, a transaction, the dashboard ----

func TestFirstVisitCreatesAWorkspaceAndWelcomes(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	u := newVerifiedUser(t, app, "Ana Silva", "ana@example.com")
	c := app.Client(t).WithHeader("Sec-Fetch-Site", "same-origin").ActingAs("web", u)

	c.Get("/dashboard").AssertOK().AssertInertia("Dashboard").
		HasProp("workspace").HasProp("dashboard")

	sent := app.Mails().SentTo("ana@example.com")
	if len(sent) != 1 || !strings.Contains(sent[0].Subject, "Welcome") {
		t.Fatalf("mails = %+v, want one welcome", sent)
	}

	// A second visit keeps the workspace and sends nothing more.
	c.Get("/dashboard").AssertOK()

	if n := len(app.Mails().SentTo("ana@example.com")); n != 1 {
		t.Errorf("mails after the second visit = %d, want 1", n)
	}

	vukemtest.AssertDatabaseCount(t, app, "workspaces", 1)
	vukemtest.AssertDatabaseHas(t, app, "memberships", map[string]any{"user_id": u.ID, "role": "owner"})
}

// Empty collections must remain JSON arrays: chart components consume them directly.
func TestEmptyDashboardCollectionsAreArrays(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	page := ana.Client.Inertia("").Get("/dashboard").AssertOK().AssertInertia("Dashboard")
	for _, key := range []string{"dashboard.categories", "dashboard.budgets"} {
		value, ok := page.Prop(key)
		rows, array := value.([]any)
		if !ok || !array || rows == nil || len(rows) != 0 {
			t.Errorf("%s = %#v, want an empty JSON array", key, value)
		}
	}
}

func TestRecordATransactionAndSeeItOnTheDashboard(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	acc := firstAccount(t, app, ana)

	salary := categoryID(t, app, ana, "Salary")
	addTransaction(t, ana, acc, salary, "income", "2500.00", today()).AssertRedirect("/transactions")
	addTransaction(
		t,
		ana,
		acc,
		categoryID(t, app, ana, "Groceries"),
		"expense",
		"80.50",
		today(),
	).AssertRedirect("/transactions")

	vukemtest.AssertDatabaseHas(t, app, "transactions", map[string]any{
		"workspace_id": ana.Workspace.ID, "kind": "expense", "amount_cents": 8050,
	})

	page := ana.Client.Inertia("").Get("/dashboard").AssertOK().AssertInertia("Dashboard")
	page.PropEquals("dashboard.balanceCents", float64(241950))
	page.PropEquals("dashboard.currency", "USD")

	// Validation: amounts are positive decimals, dates are ISO.
	// A refused form goes back to the page with the message; nothing is saved.
	addTransaction(t, ana, acc, 0, "expense", "abc", today()).AssertRedirect("/transactions")
	addTransaction(t, ana, acc, 0, "expense", "-5", today()).AssertRedirect("/transactions")
	addTransaction(t, ana, acc, 0, "expense", "5", "yesterday").AssertStatus(http.StatusSeeOther)
	vukemtest.AssertDatabaseCount(t, app, "transactions", 2)
}

