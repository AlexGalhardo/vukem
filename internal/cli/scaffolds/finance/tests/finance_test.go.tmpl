func TestBudgetAlertsAt80And100Percent(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	makePro(t, app, ana)

	acc := firstAccount(t, app, ana)
	food := categoryID(t, app, ana, "Groceries")

	ana.Client.PostForm("/budgets", url.Values{"categoryId": {strconv.FormatInt(food, 10)}, "limit": {"100.00"}}).
		AssertRedirect("/budgets")

	addTransaction(t, ana, acc, food, "expense", "50.00", today())
	addTransaction(t, ana, acc, food, "expense", "10.00", today())

	if n := len(app.Mails().SentTo("ana@example.com")); n != 0 {
		t.Fatalf("mails at 60%% = %d, want none", n)
	}

	addTransaction(t, ana, acc, food, "expense", "20.00", today()) // 80%

	sent := app.Mails().SentTo("ana@example.com")
	if len(sent) != 1 || !strings.Contains(sent[0].Subject, "Groceries budget at 80%") {
		t.Fatalf("mails at 80%% = %+v", sent)
	}

	addTransaction(t, ana, acc, food, "expense", "5.00", today()) // 85%: no second alert

	if n := len(app.Mails().SentTo("ana@example.com")); n != 1 {
		t.Fatalf("mails at 85%% = %d, want still 1", n)
	}

	addTransaction(t, ana, acc, food, "expense", "30.00", today()) // 115%

	sent = app.Mails().SentTo("ana@example.com")
	if len(sent) != 2 || !strings.Contains(sent[1].Subject, "at 100%") {
		t.Fatalf("mails at 100%% = %+v", sent)
	}

	if !strings.Contains(sent[1].HTML, "$115.00") {
		t.Errorf("the alert does not show the spent amount:\n%s", sent[1].HTML)
	}

	ana.Client.Inertia("").Get("/budgets").AssertInertia("Budgets").PropEquals("budgets.0.percent", float64(115))
}

// ---- invitations ----

func TestInviteAcceptFlow(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	makePro(t, app, ana)

	bob := newVerifiedUser(t, app, "Bob", "bob@example.com")
	eve := newVerifiedUser(t, app, "Eve", "eve@example.com")

	ana.Client.PostForm("/workspace/invites", url.Values{"email": {"Bob@Example.com"}, "role": {"member"}}).
		AssertRedirect("/workspace")

	sent := app.Mails().SentTo("bob@example.com")
	if len(sent) != 1 || !strings.Contains(sent[0].Subject, "invited you") {
		t.Fatalf("invite mails = %+v", sent)
	}

	link := inviteRe.FindString(sent[0].HTML)
	if link == "" {
		t.Fatalf("no invite link in %s", sent[0].HTML)
	}

	path := link

	// Another user with the link gets a 404, and the invite stays usable.
	browser(t, app, eve, 0).PostForm(path, nil).AssertNotFound()

	// The invited address joins; the link works once.
	b := app.Client(t).WithHeader("Sec-Fetch-Site", "same-origin").ActingAs("web", bob)
	b.Get(path).AssertOK().AssertInertia("InviteAccept")
	b.PostForm(path, nil).AssertRedirect("/dashboard")
	b.PostForm(path, nil).AssertNotFound()

	vukemtest.AssertDatabaseHas(t, app, "memberships", map[string]any{
		"workspace_id": ana.Workspace.ID, "user_id": bob.ID, "role": "member",
	})
	b.Inertia("").
		Get("/dashboard").
		AssertInertia("Dashboard").
		PropEquals("workspace.current.id", float64(ana.Workspace.ID))
}

func TestExpiredInviteIsRefused(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	makePro(t, app, ana)

	bob := newVerifiedUser(t, app, "Bob", "bob@example.com")
	ana.Client.PostForm("/workspace/invites", url.Values{"email": {"bob@example.com"}, "role": {"admin"}}).
		AssertRedirect("/workspace")

	link := inviteRe.FindString(app.Mails().SentTo("bob@example.com")[0].HTML)
	path := link

	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	if _, err := orm.QueryOf[models.Invite](db).Where("email", "bob@example.com").
		Update(t.Context(), orm.Set{"expires_at": time.Now().Add(-time.Hour).UTC()}); err != nil {
		t.Fatal(err)
	}

	app.Client(t).WithHeader("Sec-Fetch-Site", "same-origin").ActingAs("web", bob).PostForm(path, nil).AssertNotFound()
}

// ---- monthly summary ----

func TestMonthlySummaryMailsTheOwners(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	signUp(t, app, "Quiet", "quiet@example.com") // no transactions: no mail

	acc := firstAccount(t, app, ana)
	addTransaction(t, ana, acc, categoryID(t, app, ana, "Salary"), "income", "1000.00", "2026-03-05")
	addTransaction(t, ana, acc, categoryID(t, app, ana, "Housing"), "expense", "400.00", "2026-03-06")
	addTransaction(t, ana, acc, categoryID(t, app, ana, "Groceries"), "expense", "100.00", "2026-03-07")

	ws := service(t, app)

	fin, err := finance.New(app.App, ws)
	if err != nil {
		t.Fatal(err)
	}

	if err := fin.SendAllMonthlySummaries(t.Context(), "2026-03"); err != nil {
		t.Fatal(err)
	}

	sent := app.Mails().SentTo("ana@example.com")
	if len(sent) != 1 || sent[0].Subject != "Your 2026-03 summary" {
		t.Fatalf("summary mails = %+v", sent)
	}

	for _, want := range []string{"$1,000.00", "$500.00", "$500.00", "Housing", "Groceries"} {
		if !strings.Contains(sent[0].HTML, want) {
			t.Errorf("the summary does not contain %q:\n%s", want, sent[0].HTML)
		}
	}

	if n := len(app.Mails().SentTo("quiet@example.com")); n != 0 {
		t.Errorf("a workspace without transactions got %d summaries", n)
	}
}

// ---- admin ----

func TestAdminRevenueSumsTheActiveSubscriptions(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	bob := signUp(t, app, "Bob", "bob@example.com")
	makePro(t, app, ana)
	makePro(t, app, bob)

	boss := newVerifiedUser(t, app, "Boss", "boss@example.com")
	c := app.Client(t).WithHeader("Sec-Fetch-Site", "same-origin").ActingAs("web", boss).Inertia("")

	page := c.Get("/admin/revenue").AssertOK().AssertInertia("Admin/Revenue")
	page.PropEquals("mrrCents", 1800)
	page.PropEquals("active", 2)
	page.PropEquals("workspaces", 2)

	// Customers are not admins: the page does not exist for them.
	ana.Client.Get("/admin/revenue").AssertNotFound()
	app.Client(t).Get("/admin/revenue").AssertRedirect("/login")
}
