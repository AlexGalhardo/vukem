// ---- tenancy: a workspace never sees another one's rows ----

func TestTenancyIsolatesWorkspaces(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	bob := signUp(t, app, "Bob", "bob@example.com")

	accAna, accBob := firstAccount(t, app, ana), firstAccount(t, app, bob)
	addTransaction(t, ana, accAna, 0, "expense", "11.00", today()).AssertRedirect("/transactions")

	var anaTx models.Transaction

	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	if anaTx, err = workspaces.Scoped[models.Transaction](
		workspaces.WithTenant(t.Context(), ana.Workspace.ID),
		db,
	).First(t.Context()); err != nil {
		t.Fatal(err)
	}

	// Bob sees none of it, and cannot delete it.
	bob.Client.Inertia("").Get("/transactions").AssertInertia("Transactions").HasProp("transactions", 0)
	bob.Client.Delete("/transactions/" + strconv.FormatInt(anaTx.ID, 10)).AssertNotFound()
	vukemtest.AssertDatabaseCount(t, app, "transactions", 1)

	// Bob cannot write into Ana's account or category either.
	addTransaction(t, bob, accAna, 0, "expense", "1.00", today()).AssertRedirect("/transactions")
	addTransaction(
		t,
		bob,
		accBob,
		categoryID(t, app, ana, "Groceries"),
		"expense",
		"1.00",
		today(),
	).AssertRedirect("/transactions")
	bob.Client.Delete("/accounts/" + strconv.FormatInt(accAna, 10)).AssertNotFound()
	vukemtest.AssertDatabaseCount(t, app, "transactions", 1)

	// A forged workspace id in the session falls back to Bob's own workspace.
	forged := browser(t, app, bob.User, ana.Workspace.ID)
	forged.Inertia("").Get("/transactions").AssertInertia("Transactions").HasProp("transactions", 0)
	forged.Inertia("").
		Get("/dashboard").
		AssertInertia("Dashboard").
		PropEquals("workspace.current.id", float64(bob.Workspace.ID))

	// The switcher is no way in either: the next request checks the membership.
	bob.Client.PostForm("/workspaces/"+strconv.FormatInt(ana.Workspace.ID, 10)+"/switch", nil).
		AssertRedirect("/dashboard")
	bob.Client.Inertia("").
		Get("/dashboard").
		AssertInertia("Dashboard").
		PropEquals("workspace.current.id", float64(bob.Workspace.ID))

	// Without a workspace in the context a scoped query matches nothing.
	n, err := workspaces.Scoped[models.Transaction](t.Context(), db).Count(t.Context())
	if err != nil || n != 0 {
		t.Errorf("scoped count without a tenant = %d, %v; want 0", n, err)
	}

	// Inserts need a tenant, and take it from the context, never from the model.
	err = orm.Create(
		t.Context(),
		db,
		&models.Transaction{AccountID: accAna, Kind: "expense", AmountCents: 1, OccurredOn: today()},
	)
	if err == nil {
		t.Error("an insert without a tenant succeeded")
	}

	forgedTx := models.Transaction{
		WorkspaceID: ana.Workspace.ID,
		AccountID:   accBob,
		Kind:        "expense",
		AmountCents: 5,
		OccurredOn:  today(),
	}
	if err := orm.Create(workspaces.WithTenant(t.Context(), bob.Workspace.ID), db, &forgedTx); err != nil {
		t.Fatal(err)
	}

	if forgedTx.WorkspaceID != bob.Workspace.ID {
		t.Errorf("workspace_id = %d, want the context tenant %d", forgedTx.WorkspaceID, bob.Workspace.ID)
	}
}

