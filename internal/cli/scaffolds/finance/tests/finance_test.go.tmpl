// ---- roles ----

func TestRolesDecideWhoMayDoWhat(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	owner := signUp(t, app, "Olga", "olga@example.com")
	adminUser := newVerifiedUser(t, app, "Adam", "adam@example.com")
	memberUser := newVerifiedUser(t, app, "Mia", "mia@example.com")
	join(t, app, owner, adminUser, models.RoleAdmin)
	join(t, app, owner, memberUser, models.RoleMember)

	admin := who{adminUser, owner.Workspace, browser(t, app, adminUser, owner.Workspace.ID)}
	member := who{memberUser, owner.Workspace, browser(t, app, memberUser, owner.Workspace.ID)}
	acc := firstAccount(t, app, owner)

	// Everyone records transactions.
	addTransaction(t, member, acc, 0, "expense", "3.00", today()).AssertRedirect("/transactions")

	// Members cannot manage data, people or billing.
	member.Client.PostForm("/categories", url.Values{"name": {"Pets"}, "kind": {"expense"}}).AssertForbidden()
	member.Client.PostForm("/workspace/invites", url.Values{"email": {"x@example.com"}, "role": {"member"}}).
		AssertForbidden()
	member.Client.PostForm("/billing/portal", nil).AssertForbidden()

	// Admins manage data and people but not billing.
	admin.Client.PostForm("/categories", url.Values{"name": {"Pets"}, "kind": {"expense"}}).
		AssertRedirect("/categories")
	admin.Client.PostForm("/billing/checkout/pro", nil).AssertForbidden()
	admin.Client.Delete("/workspace/members/" + strconv.FormatInt(memberUser.ID, 10)).AssertRedirect("/workspace")

	// Nobody removes the owner.
	admin.Client.Delete("/workspace/members/" + strconv.FormatInt(owner.User.ID, 10)).AssertRedirect("/workspace")

	if n := count[models.Membership](t, app, owner); n != 2 {
		t.Errorf("memberships = %d, want the owner and the admin", n)
	}
}

