// ---- plan limits ----

func TestFreePlanLimits(t *testing.T) {
	t.Parallel()

	app := newApp(t)
	ana := signUp(t, app, "Ana", "ana@example.com")
	acc := firstAccount(t, app, ana)

	// One account on Free; the answer sends the user to /billing.
	ana.Client.PostForm("/accounts", url.Values{"name": {"Savings"}, "kind": {"savings"}}).AssertRedirect("/billing")
	vukemtest.AssertDatabaseCount(t, app, "accounts", 1)

	// Budgets and CSV import are Pro features.
	groceries := categoryID(t, app, ana, "Groceries")
	ana.Client.PostForm("/budgets", url.Values{"categoryId": {strconv.FormatInt(groceries, 10)}, "limit": {"300"}}).
		AssertRedirect("/billing")
	ana.Client.Inertia("").Get("/import").AssertInertia("Import").PropEquals("enabled", false)

	// One member: an invitation is refused.
	ana.Client.PostForm("/workspace/invites", url.Values{"email": {"bob@example.com"}, "role": {"member"}}).
		AssertRedirect("/billing")
	vukemtest.AssertDatabaseCount(t, app, "invites", 0)

	// 100 transactions a month, then the 101st is refused.
	db, err := app.DB()
	if err != nil {
		t.Fatal(err)
	}

	month := time.Now().UTC().Format("2006-01")
	rows := make([]models.Transaction, 100)

	for i := range rows {
		rows[i] = models.Transaction{
			AccountID:   acc,
			Kind:        "expense",
			AmountCents: 100,
			Description: "bulk",
			OccurredOn:  month + "-15",
		}
	}

	if err := orm.CreateMany(workspaces.WithTenant(t.Context(), ana.Workspace.ID), db, rows); err != nil {
		t.Fatal(err)
	}

	addTransaction(t, ana, acc, 0, "expense", "1.00", month+"-16").AssertRedirect("/billing")
	vukemtest.AssertDatabaseCount(t, app, "transactions", 100)

	// The limit is per month: another month still has room.
	addTransaction(t, ana, acc, 0, "expense", "1.00", "2020-01-16").AssertRedirect("/transactions")

	// Pro lifts every limit.
	makePro(t, app, ana)

	addTransaction(t, ana, acc, 0, "expense", "1.00", month+"-16").AssertRedirect("/transactions")
	ana.Client.PostForm("/accounts", url.Values{"name": {"Savings"}, "kind": {"savings"}}).AssertRedirect("/accounts")
	ana.Client.PostForm("/budgets", url.Values{"categoryId": {strconv.FormatInt(groceries, 10)}, "limit": {"300"}}).
		AssertRedirect("/budgets")
	ana.Client.PostForm("/workspace/invites", url.Values{"email": {"bob@example.com"}, "role": {"member"}}).
		AssertRedirect("/workspace")

	ana.Client.Inertia("").Get("/dashboard").AssertInertia("Dashboard").PropEquals("workspace.plan", "pro")
}

