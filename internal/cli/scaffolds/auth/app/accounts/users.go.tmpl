package accounts

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/AlexGalhardo/vukem/database"
	"github.com/AlexGalhardo/vukem/orm"

	"{{.Module}}/app/mail"
	"{{.Module}}/app/models"
	"{{.Module}}/app/requests"
)

// Register creates a user (unique email, hashed password) and sends the
// verification email.
func (a *Accounts) Register(ctx context.Context, in requests.Register) (models.User, error) {
	email := strings.ToLower(in.Email)

	if err := orm.Validate(ctx, a.DB, orm.Unique[models.User]("email", email)); err != nil {
		return models.User{}, err
	}

	h, err := a.Hasher.Make(in.Password)
	if err != nil {
		return models.User{}, err
	}

	u := models.User{Name: in.Name, Email: email, Password: h}
	if err := orm.Create(ctx, a.DB, &u); err != nil {
		return models.User{}, err
	}

	return u, a.SendVerification(ctx, u)
}

// SendVerification emails a signed link that verifies u's address.
func (a *Accounts) SendVerification(ctx context.Context, u models.User) error {
	link, err := a.Signer.Sign(fmt.Sprintf("%s/email/verify/%d", a.URL, u.ID), a.VerifyTTL)
	if err != nil {
		return err
	}

	return a.Mailer.Send(ctx, mail.VerifyEmail{User: u, Link: link})
}

// MarkVerified sets email_verified_at.
func (a *Accounts) MarkVerified(ctx context.Context, u *models.User) error {
	if u.EmailVerified() {
		return nil
	}

	u.EmailVerifiedAt = orm.NullTime{}
	u.EmailVerifiedAt.V, u.EmailVerifiedAt.Valid = a.now().UTC(), true

	_, err := orm.QueryOf[models.User](a.DB).Where("id", u.ID).Update(ctx, orm.Set{"email_verified_at": u.EmailVerifiedAt.V})

	return err
}

// UpdatePassword stores a new hash for u inside tx.
func (a *Accounts) updatePassword(ctx context.Context, tx database.Executor, id int64, password string) error {
	h, err := a.Hasher.Make(password)
	if err != nil {
		return err
	}

	_, err = orm.QueryOf[models.User](tx).Where("id", id).Update(ctx, orm.Set{"password": h})

	return err
}

func (a *Accounts) expired(created time.Time, ttl time.Duration) bool { return a.now().After(created.Add(ttl)) }
