package bootstrap

import (
	vukem "github.com/AlexGalhardo/vukem"

	"example.com/blog/app/providers"
)

// Providers lists the application providers, in registration order.
// vukem make:provider appends to this list.
func Providers() []vukem.Provider {
	return []vukem.Provider{
		&providers.AppProvider{}, // core services
		&providers.BillingProvider{},
	}
}
